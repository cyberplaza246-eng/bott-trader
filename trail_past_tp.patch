+def _long_pos(*, trailing=True, order_id="bot_long1", tp=25100.0, sl=24960.0):
+    return slr.Position(
+        order_id=order_id,
+        symbol="MNQ",
+        direction="long",
+        entry_price=25000.0,
+        size=1,
+        sl=sl,
+        tp=tp,
+        entry_time=datetime.now(timezone.utc),
+        trailing_enabled=trailing,
+    )
+
+
+def test_profit_lock_defaults_100_to_20():
+    assert slr.PROFIT_LOCK_TRIGGER_1_USD == 100.0
+    assert slr.PROFIT_LOCK_LEVEL_1_USD == 20.0
+    assert slr.PROFIT_LOCK_TRIGGER_2_USD == 150.0
+    assert slr.PROFIT_LOCK_LEVEL_2_USD == 50.0
+
+
+def test_profit_lock_100_moves_sl_to_plus_20():
+    t = _trader()
+    t.paper_orders = True
+    pos = _long_pos(sl=24960.0, tp=25100.0)
+    t.positions[pos.order_id] = pos
+    # +$100 uPnL on MNQ ($2/pt, 1 ct) = +50 pts → price 25050
+    df = pd.DataFrame([{"high": 25050.0, "low": 25010.0, "close": 25050.0, "atr": 15.0}])
+    t.update_dollar_profit_locks("MNQ", df)
+    # Lock +$20 = +10 pts → SL 25010
+    assert pos.profit_lock_level == 1
+    assert pos.sl == pytest.approx(25010.0)
+    assert pos.sl > 24960.0
+
+
+def test_past_tp_cancels_tp_enables_trail_and_floors_sl():
+    t = _trader()
+    t.paper_orders = True
+    pos = _long_pos(sl=24960.0, tp=25100.0)
+    t.positions[pos.order_id] = pos
+    # High beyond TP; low stays above floored SL so we only assert no TAKE_PROFIT.
+    df = pd.DataFrame([{"high": 25140.0, "low": 25105.0, "close": 25120.0, "atr": 20.0}])
+    t.update_past_tp_to_trail("MNQ", df)
+    assert pos.tp_cleared is True
+    assert pos.tp == 0.0
+    assert pos.original_tp == pytest.approx(25100.0)
+    assert pos.trailing_enabled is True
+    # SL floored at original TP
+    assert pos.sl == pytest.approx(25100.0)
+    # Local exit check must NOT emit TAKE_PROFIT once TP cleared
+    exits = t.check_position_exit("MNQ", df)
+    assert not any(et == "TAKE_PROFIT" for _, et in exits)
+    assert exits == []
+
+
+def test_past_tp_calls_broker_cancel_take_profit_live():
+    t = _trader()
+    t.paper_mode = False
+    t.paper_orders = False
+    pos = _long_pos(sl=24960.0, tp=25100.0)
+    t.positions[pos.order_id] = pos
+    t.broker.cancel_take_profit.return_value = True
+    t.broker.update_stop_loss.return_value = True
+    df = pd.DataFrame([{"high": 25125.0, "low": 25090.0, "close": 25120.0, "atr": 20.0}])
+    t.update_past_tp_to_trail("MNQ", df)
+    assert t.broker.cancel_take_profit.called
+    kwargs = t.broker.cancel_take_profit.call_args.kwargs
+    assert kwargs["ticket"] == pos.order_id
+    assert kwargs["symbol"] == "MNQ"
+    assert pos.tp_cleared is True
+    assert pos.trailing_enabled is True
+
+
+def test_past_tp_keeps_tp_if_cancel_fails():
+    t = _trader()
+    t.paper_mode = False
+    t.paper_orders = False
+    pos = _long_pos(sl=24960.0, tp=25100.0)
+    t.positions[pos.order_id] = pos
+    t.broker.cancel_take_profit.return_value = False
+    df = pd.DataFrame([{"high": 25125.0, "low": 25090.0, "close": 25120.0, "atr": 20.0}])
+    t.update_past_tp_to_trail("MNQ", df)
+    assert pos.tp_cleared is False
+    assert pos.tp == pytest.approx(25100.0)
+
+
+def test_trail_after_past_tp_never_loosens_through_original_tp():
+    t = _trader()
+    t.paper_orders = True
+    pos = _long_pos(sl=25100.0, tp=0.0)
+    pos.tp_cleared = True
+    pos.original_tp = 25100.0
+    pos.trailing_enabled = True
+    t.positions[pos.order_id] = pos
+    # Wide ATR would want SL far below original TP — floor must hold.
+    df = pd.DataFrame([{"high": 25140.0, "low": 25105.0, "close": 25130.0, "atr": 80.0}])
+    t.update_trailing_stops("MNQ", df)
+    assert pos.sl >= 25100.0 - 1e-9
+
+
