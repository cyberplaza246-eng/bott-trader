# Broker type: "mt5" (forex), "rithmic" (futures direct), "traderspost" (futures webhook)
BROKER_TYPE=mt5
# Asset class: "forex" or "futures"
ASSET_CLASS=forex

# MT5 Connection (fill in your account details)
MT5_ACCOUNT=YOUR_ACCOUNT_NUMBER
MT5_PASSWORD=YOUR_PASSWORD
MT5_SERVER=YOUR_SERVER

# Optional: only needed if running bot on Linux with relay
MT5_RELAY_URL=
MT5_RELAY_TOKEN=

# News API (optional — live headlines for news bias; free tier at https://newsapi.org)
NEWSAPI_KEY=

# Tiingo news (optional — requires News API subscription, not included on free EOD tier)
# https://www.tiingo.com/documentation/news | https://www.tiingo.com/products/news
TIINGO_API_KEY=
# Default true when TIINGO_API_KEY is set; set false to disable Tiingo fetches
USE_TIINGO_NEWS=true

# LLM / Gemini (or DeepSeek) trade advisor — second opinion on rule-based entries.
# ema15_eod defaults to LLM_MODE=advisory so Gemini cannot skip the locked edge.
# Use LLM_MODE=block only if you want Gemini to gate entries (not recommended for ema15).
LLM_ENABLED=true
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_MODE=advisory
# LLM_MIN_CONFIDENCE=0.60
# LLM_MIN_SETUP_SCORE=60
# LLM_CACHE_TTL_SEC=900
# LLM_TIMEOUT_SEC=12
# DeepSeek alternative (do NOT set LLM_PROVIDER=deepseek while Gemini is the desk advisor)
# LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# DeepSeek trade outcome learner (hybrid scalp — learns from closed trades)
# Local pattern blocking works WITHOUT an API key (hybrid only).
# ema15_eod forces these OFF so they cannot change stops/windows; use the journal suggestions instead.
# KEEP USE_DEEPSEEK_LEARNER=false for locked ema15_eod — learner must not auto-tweak live rules.

# Locked ema15_eod live recipe (RTH, flatten 15:50, no trail). Default ON.
# First lot and all entries: daily permission + 15m EMA8/21 + 60m EMA8/21 same direction.
# Afternoon windows and a 2nd lot still need sep/ATR >= 0.45 on top.
# EMA15_REQUIRE_DAILY=true
EMA15_REQUIRE_60M=true
# EMA15_SL_ATR_MULT=2.0
# EMA15_SL_MIN=20
# EMA15_SL_MAX=60
USE_LOCAL_PATTERN_LEARNER=true
USE_DEEPSEEK_LEARNER=false
# USE_DEEPSEEK_LEARNER=true          # optional: DeepSeek AI analysis every N closes (hybrid only)
# DEEPSEEK_LEARN_EVERY_N=5          # call DeepSeek after every N closes (local stats always on)
# DEEPSEEK_LEARN_MIN_CONF=0.55       # min AI confidence before block_conditions gate entries
# DEEPSEEK_LEARN_TIMEOUT_SEC=15
DEEPSEEK_LEARN_MODEL=deepseek-chat   # keep DeepSeek model separate from Gemini LLM_MODEL
# Journal: data/trade_journal.jsonl (live) / data/paper_trade_journal.jsonl (paper)
# Suggestions: data/trade_suggestions.json — advisory only, never auto-applied
# SUGGEST_MIN_TRADES=30
# SUGGEST_MIN_LOSERS=10
# SUGGEST_MIN_CLUSTER=5

# Adaptive learner — records every close, tightens weak setups (both live paths)
# USE_ADAPTIVE_LEARNER=true          # default ON — journal + SL tuning on each close
ADAPTIVE_SKIP_ENABLED=false          # KEEP false — regime/hour/pair skip BLOCKS entries; advisory only when off
# Persists to data/adaptive_learning.json (stale volatile stats must NOT block when skip=false)

# Consecutive-loss halt (per symbol) — MTF scalping + ensemble rithmic paths
# Default OFF — profitability path tightens entries instead of pausing
# MTF_MAX_CONSEC_LOSSES=3
# MTF_CONSEC_LOSS_PAUSE_MINUTES=30
# ENSEMBLE_MAX_CONSEC_LOSSES=3
# ENSEMBLE_CONSEC_LOSS_PAUSE_MINUTES=30

# News bias advisor — macro headlines + DeepSeek summary (NQ/MNQ positioning)
# USE_LLM_NEWS=false
# LLM_NEWS_MODE=advisory       # advisory = log only | block = gate entries | boost = size bump
# LLM_NEWS_MIN_CONFIDENCE=0.65
# LLM_NEWS_BLOCK_CONFIDENCE=0.80
# LLM_NEWS_BOOST_PCT=25
LLM_NEWS_CACHE_TTL_SEC=900  # 15 min fresher news bias
# Console news/policy display (full detail always in logs/trading_bot.log)
COMPACT_NEWS=true              # one-line bias + optional headline bullets
NEWS_CONSOLE=true              # false = hide all news on console (logs only)
NEWS_HEADLINE_COUNT=2          # 0 = bias line only; 1-2 = add truncated headline bullets (60 chars)
POLICY_CONSOLE=false           # false = hide policy on console (logs only); true shows e.g. 🏛️ -2 [Fed]

# Policy scorer — headline categorize + score (-5..+5) + MTF confirm (richer than news_bias)
# USE_POLICY_SCORER=false
# POLICY_SCORER_MODE=advisory       # advisory | block | boost (start advisory = log only)
# POLICY_SCORER_MIN_SCORE=3
# POLICY_SCORER_MIN_CONFIDENCE=0.70
# POLICY_SCORER_BOOST_PCT=25
# POLICY_SCORER_CACHE_TTL_SEC=1800

# Order flow — rolling tick delta from Rithmic BBO + last trade
# Required for flow_entry_guard (blocks longs on sell flow). Sim: USE_ORDER_FLOW=true
# USE_ORDER_FLOW=true
# ORDER_FLOW_MODE=block            # block = gate entries | advisory = log only
# ORDER_FLOW_WINDOW_SEC=60
# USE_FLOW_DI_OVERRIDE=true        # relax DI gap when flow confirms direction
# DI_TOLERANCE=3                   # base DI+/DI- gap allowed (pts)
# DI_FLOW_TOLERANCE=8              # relaxed DI gap when flow confirms (pts)
# Flow-confirmed counter-trend (sell in bullish 5M / buy in bearish 5M when flow contradicts EMA)
# FLOW_COUNTER_TREND=true          # also in data/mnq_profit_config.json flow_counter_trend.enabled
# FLOW_COUNTER_DI_MARGIN=12        # relaxed DI margin when flow strongly confirms (default 12 vs std 20)
# FLOW_COUNTER_ADX_MIN=17          # relaxed ADX min when flow confirms (default 17 vs std 25)
# FLOW_COUNTER_DELTA_MIN=100       # |delta| required for strong flow confirmation
# FLOW_COUNTER_REGIME_SCANS=3      # consecutive scans flow vs 5M EMA before regime override
# Flow entry guard — block trend entries against live tick flow (also in mnq_profit_config.json)
# FLOW_ENTRY_GUARD=true
# FLOW_LONG_BUY_PCT_MIN=0.48       # block LONG when delta<0 and buy% below this
# FLOW_SHORT_BUY_PCT_MAX=0.52      # block SHORT when delta>0 and buy% above this
# Relax flow/DI when 5M ADX is strong (baseline mode — reduces over-filtering)
# DI_RELAX_STRENGTH=20             # skip DI+/DI- gate when ADX >= this
# FLOW_RELAX_STRENGTH=20           # allow LONG with buy% >= FLOW_RELAX_LONG_BUY_PCT when ADX >= this
# FLOW_RELAX_LONG_BUY_PCT=0.45     # even if delta is negative

# Full PASS/BLOCK gate diagnostics every scan when flat (recommended)
FULL_TRADE_DIAGNOSTICS=true

# Scalp momentum Version B (backtest_scalp_momentum.py) — simpler gates, fixed SL/TP
# USE_SCALP_MOMENTUM=true          # or STRATEGY_MODE=scalp_b
# STRATEGY_MODE=scalp_b            # 5M VWAP+EMA20+ADX, 1M pullback, 30s trigger bar
# SCALP_SL_PTS=8
# SCALP_TP_PTS=14
# SCALP_SL_MIN=6                 # floor SL (also max(SCALP_SL_MIN, 0.4×1M ATR) when ATR bounds on)
# SCALP_SL_MAX=12                # cap SL (also min(SCALP_SL_MAX, 1.0×1M ATR) when ATR bounds on)
# SCALP_TP_MIN=10
# SCALP_TP_MAX=20
# SCALP_MIN_RR=1.4               # TP >= SL × min_rr (clamped to SCALP_TP_MIN/MAX)
# SCALP_USE_ATR_BOUNDS=true      # false = fixed SL/TP clamped to min/max only
# SCALP_ADX_MIN=20
# SCALP_PULLBACK_ATR=0.5
# SCALP_SETUP_BARS=3
# MAX_HOLD_SECONDS=90              # auto-set in scalp_b if unset
# USE_30S_BARS=true                # auto-enabled in scalp_b for 30s trigger bars

# Hybrid scalp (backtest_scalp_hybrid.py) — Pullback A + Continuation B
# SCALP_MODE=hybrid                # hybrid | pullback | continuation
# STRATEGY_MODE=scalp_hybrid       # alias for SCALP_MODE=hybrid
#
# ── PROFIT MODE (docs/PROFITABLE_LIVE.md) — ultra_fast winner ──
# OVERNIGHT_TRADING=false
# SESSION_MODE=rth
# SCALP_SESSIONS=morning=09:30-12:00;afternoon=13:30-16:00
#   (set SCALP_SESSIONS=off for full RTH; empty uses same default when hybrid)
#
# ── Recommended fast scalp (backtest winner Jun 2026, MNQ_1m Dec-Mar) ──
# 1087 trades | WR 56.6% | PF 2.26 | avg hold 30s | PnL $1941 vs baseline PF 1.13
# Also stored in data/mnq_profit_config.json → scalp_hybrid (auto-loaded if env unset)
# SCALP_MODE=hybrid
# STRATEGY_MODE=scalp_hybrid
# SCALP_AGGRESSIVE=true
# SCALP_SL_PTS=6
# SCALP_TP_PTS=14
# SCALP_SL_MIN=6
# SCALP_SL_MAX=10
# SCALP_TP_MIN=10
# SCALP_TP_MAX=16
# SCALP_MIN_RR=1.4
# MAX_HOLD_SECONDS=30              # 30s TIME exit — key to fast rotation (30s bar granularity)
# SCALP_ADX_MIN=15
# SCALP_CONTINUATION_ADX_MIN=18
# SCALP_PULLBACK_ATR=0.85
# SCALP_SETUP_BARS=2
# SCALP_SETUP_WINDOW_SEC=60
# SCALP_TREND_MODE=vwap
# SCALP_CONTINUATION_VOLUME=false
# SCALP_CHASE_BODY_MULT=2.5
# SCALP_CHASE_EMA_ATR=1.5
# SCALP_MOMENTUM_BURST=true
# SCALP_MOMENTUM_BURST_ADX=15
# SCALP_BREAKEVEN_PCT=0.35
# SCALP_TRIGGER_RELAX_FLOW=true
# USE_ORDER_FLOW=true            # flow-confirmed triggers + chase relax (live parity)
#
# PULLBACK_ENABLED=true            # Scalp A: 5M trend + 1M pullback + 30s trigger
# CONTINUATION_ENABLED=true        # Scalp B: 5M momentum + vol rising + 30s break (no pullback)
# SCALP_SL_PTS=8
# SCALP_TP_PTS=14
# SCALP_SL_MIN=6                 # floor SL (also max(SCALP_SL_MIN, 0.4×1M ATR) when ATR bounds on)
# SCALP_SL_MAX=12                # cap SL (also min(SCALP_SL_MAX, 1.0×1M ATR) when ATR bounds on)
# SCALP_TP_MIN=10
# SCALP_TP_MAX=20
# SCALP_MIN_RR=1.4               # TP >= SL × min_rr (clamped to SCALP_TP_MIN/MAX)
# SCALP_USE_ATR_BOUNDS=true      # false = fixed SL/TP clamped to min/max only
# SCALP_ADX_MIN=20                 # pullback ADX floor
# SCALP_CONTINUATION_ADX_MIN=25    # continuation ADX floor
# SCALP_PULLBACK_ATR=0.75          # wider zone = more setups (default 0.5 strict)
# SCALP_SETUP_BARS=3               # setup window = bars × TRIGGER_BAR_SECONDS (or use SCALP_SETUP_WINDOW_SEC)
# SCALP_SETUP_WINDOW_SEC=90        # explicit setup window seconds (overrides bars×30 when set)
# SCALP_TREND_MODE=vwap            # vwap = close vs VWAP only (fixes dir=0 chop) | both = VWAP+EMA20
# SCALP_CONTINUATION_VOLUME=false  # false = allow vol not declining sharply (see SCALP_CONT_VOLUME_MIN_RATIO)
# SCALP_CONT_VOLUME_MIN_RATIO=0.85 # min vol vs prior 5M bar when continuation volume relaxed
# SCALP_CHASE_BODY_MULT=2.0        # block chase when 30s body > N× avg (default 1.5)
# SCALP_CHASE_EMA_ATR=1.25         # block chase when dist from 1M EMA20 > N× ATR (default 1.0; 1.25 aggressive)
# SCALP_CHASE_EMA_ATR_FLOW=2.5     # relaxed EMA distance when flow confirms (default 2.0; 2.5 aggressive)
# SCALP_CHASE_BODY_MULT_FLOW=2.0   # relaxed 30s body cap when flow confirms
# SCALP_CHASE_FLOW_RELAX=true      # widen chase limits on strong flow (delta+/buy%≥60% long)
# SCALP_CHASE_SKIP_ON_FLOW=false   # true = skip chase entirely when flow confirms (aggressive trending)
# SCALP_CHASE_FLOW_BUY_PCT_LONG=0.60
# SCALP_CHASE_FLOW_BUY_PCT_SHORT=0.40
# SCALP_CHASE_FLOW_DELTA_MIN=0     # min |delta| for chase relax (0 = any positive/negative)
# SCALP_MOMENTUM_BURST=true        # optional ADX≥25 micro-entry on 30s break without full setup
# SCALP_MOMENTUM_BURST_ADX=25
# SCALP_AGGRESSIVE=true             # Sunday/chop: ADX≥15, VWAP trend, flow burst when dir=0
# SCALP_FLOW_BURST_DELTA_MIN=50      # |delta| for flow-confirmed burst when trend unclear
# SCALP_TRIGGER_MICRO_BREAK_PTS=0.25 # aggressive continuation: close > prev high + N pts
# SCALP_FLOW_TRIGGER_DELTA_MIN=30    # flow-confirmed trigger when close > prev close
# SCALP_FLOW_TRIGGER_BUY_PCT_LONG=0.55
# SCALP_FLOW_TRIGGER_BUY_PCT_SHORT=0.45
# SCALP_FLOW_STRONG_DELTA_MIN=100    # strong flow: close > prev close (no prev-high break)
# SCALP_FLOW_STRONG_BUY_PCT_LONG=0.60
# SCALP_FLOW_STRONG_BUY_PCT_SHORT=0.40
# SCALP_TRIGGER_RELAX_FLOW=true         # allow non-green 30s bar when flow confirms (default ON in aggressive)
# SCALP_TRIGGER_RELAX_BUY_PCT_LONG=0.60   # min buy% for LONG trigger relax
# SCALP_TRIGGER_RELAX_BUY_PCT_SHORT=0.40  # max buy% for SHORT trigger relax
# SCALP_TRIGGER_RELAX_DELTA_MIN=0         # min |delta| for trigger relax (0 = any positive/negative)
# SCALP_RSI_GATE=true                     # hybrid: block shorts when RSI oversold / longs when overbought
# SCALP_RSI_MIN_SHORT=40                  # min 1M RSI to short (blocks selling the dip)
# SCALP_RSI_MAX_LONG=65                   # max 1M RSI to long (blocks buying the top)
# SCALP_RSI_RELAX_ADX=25                  # with trend+flow: allow short down to relax min / long up to relax max
# SCALP_RSI_RELAX_MIN_SHORT=35            # relaxed short floor when ADX≥relax + flow confirms
# SCALP_RSI_RELAX_MAX_LONG=70             # relaxed long ceiling in strong uptrend + flow
# MIN_SECONDS_BETWEEN_ENTRIES=0    # min gap between entries per symbol (0 = no gap)
# MAX_HOLD_SECONDS=60              # auto-set in hybrid if unset
# USE_30S_BARS=true                # auto-enabled in hybrid (required for entry trigger)
# MAX_POSITIONS=2                  # auto-set in hybrid if unset
# MNQ_MAX_POSITIONS=2
# BROKER_POSITION_BLOCK=true
# LOSS_COOLDOWN_MINUTES=15

# Fast scalp (session-open / quick 30s–2min trades — default ON for hybrid/scalp modes)
# SCALP_FAST_MODE=true             # false to require full 5M warmup (30 bars)
# MIN_5M_BARS_SCALP_IDEAL=20       # ideal 5M bars (was 30)
# MIN_5M_BARS_SCALP_FLOOR=15       # min 5M bars before 1M trend fallback
# CANDLE_1M_COUNT=300              # 1M bars requested from Rithmic
# CANDLE_HISTORY_HOURS=8           # paginate up to N hours back for 1M/5M history
# FAST_SCAN_LOG=true               # one-line scan summary; skips verbose gate dump
# SHOW_NEWS=false                  # skip news/policy fetch each scan (faster)
# SCALP_30S_FALLBACK_1M=false      # fast mode: 30s trigger only (no 1M trigger fallback)

# FVS-1 — Fabio Valentini Scalper (opt-in; does not change hybrid defaults)
# SCALP_MODE=fvs1_log              # fvs1_log | fvs1 | hybrid | pullback | continuation
# STRATEGY_MODE=fvs1               # alias for SCALP_MODE=fvs1
# FVS1_LOG_ONLY=true               # default true — set false for live FVS-1 entries
# FVS1_ADX_MIN=25
# FVS1_BALANCE_LOOKBACK=20
# FVS1_BALANCE_ATR_MULT=0.5
# FVS1_IMPULSE_MIN_BARS=3
# FVS1_VP_BINS=40
# FVS1_VALUE_AREA_PCT=0.70
# FVS1_ABSORPTION_MIN_BARS=2
# FVS1_MAX_HOLD_SECONDS=90
# FVS1_ROUND_TRIP_FEE=1.50
# FVS1_MAX_CONSECUTIVE_LOSSES=3
# FVS1_EXPECTANCY_WINDOW=50
# FVS1_PAUSE_ON_NEGATIVE_E=false
# FVS1_SESSIONS=ny_open=09:30-10:00;pm=14:00-15:00
# Sessions YAML: config/fvs1_sessions.yaml

# Ghost position: force-sync when broker flat but fill not confirmed (seconds)
# GHOST_FLAT_GRACE_SEC=30
# BROKER_FLAT_SYNC_SEC=30

# Volatility filter — max 1M bar range (high-low pts); global or per-symbol
# MAX_1M_BAR_PTS=60                # all symbols
# MAX_1M_BAR_PTS=NQ:60,MNQ:45      # per symbol (NQ default 60 in code if unset)

# Risk Management
RISK_PER_TRADE_PERCENT=1.0
MAX_CONCURRENT_TRADES=3
DAILY_LOSS_LIMIT_PERCENT=10
INITIAL_BALANCE=50
FIXED_LOT_SIZE=0.02

# Signal Thresholds
ENSEMBLE_CONFIDENCE_THRESHOLD=0.50
MIN_MODELS_AGREEMENT=2
SIGNAL_COOLDOWN_MINUTES=5
ENABLE_CORRELATION_GUARD=false

# Rithmic Connection (direct futures — recommended for Lucid/TradeSea)
# Get credentials from your TradeSea/Lucid account
RITHMIC_USER_ID=
RITHMIC_PASSWORD=
RITHMIC_SYSTEM=LucidTrading
# Lucid live trading — REQUIRED for real fills (not simulator):
# RITHMIC_TRADE_ROUTE=your_live_route_name   # NOT "simulator" — check R|Trader route list
# RITHMIC_ACCOUNT_ID=your_funded_account_id  # If multiple accounts; omit if only one
# RITHMIC_ALLOW_SIMULATOR=false              # Set true only to deliberately trade sim route
# RITHMIC_GATEWAY=  # Leave empty to auto-detect from system name
# RITHMIC_CONNECT_TIMEOUT=90   # Seconds; increase if ForcedLogout/reconnect is slow
# RITHMIC_CONNECT_RETRIES=2    # Retry after closing stale sessions
# RITHMIC_REQUEST_TIMEOUT=45   # Per-request timeout on ticker/history plant (template 113 etc.)
# RITHMIC_REQUEST_RETRIES=2    # Library-level retries per request (keep low to avoid scan stalls)
# RITHMIC_MARKET_DATA_TIMEOUT=90  # Sync timeout for deferred front-month + quote subscribe
# RITHMIC_FRONT_MONTH_RETRIES=2   # App-level retries before falling back to base symbol
# RITHMIC_CONTRACT_OVERRIDES=NQ=NQM6,MNQ=MNQM6  # Skip template-113 lookup when set

# Trading Mode: 'live', 'paper', 'backtest' (default when neither --paper nor --live is passed)
# For real Rithmic orders use: python start_live_mtf_scalping.py --live  or start_nq_live.bat / start_mnq_live.bat
TRADING_MODE=live

# Live MTF session: RTH default (Mon–Fri 9:30–4:30 ET). Globex extended hours:
# OVERNIGHT_TRADING=true   or   SESSION_MODE=extended
# SESSION_MODE=rth
# OVERNIGHT_TRADING=false

# 15M higher-timeframe bias (from data/mnq_profit_config.json by default; env overrides JSON)
# 15m_bias_mode in JSON or 15M_BIAS_MODE env: ema_cross | price_ema50 | hybrid
# ema_cross (default): bullish when EMA50 > EMA200 on native Rithmic 15m bars
# price_ema50: bullish when close > EMA50 on last 15M bar
# hybrid: bullish if close > EMA50 OR EMA50 > EMA200; bearish if close < EMA50 AND EMA50 < EMA200
# 15M_BIAS_MODE=ema_cross
# 15M_BIAS_BUFFER_PTS=0   # optional neutral zone (points) for price_ema50 / hybrid
# USE_15M_BIAS=false  # disable 15M computation entirely
# USE_15M_ENTRY_GATE=false  # default: 15M shown for direction only, does not block entries (see 15m_entry_gate in mnq_profit_config.json)
# PULLBACK_ATR_MULT=1.5  # widen 1M pullback zone when 5M ADX >= 40
# soft_15m_bias stays in mnq_profit_config.json — neutral 15M allows both directions when entry gate is on

# MTF scalping exit / risk (start_live_mtf_scalping.py)
# Daily entry caps (round-trips counted on order fill, not on close)
# MAX_TRADES_PER_DAY=20          # All symbols
# Concurrent open positions (each entry qty=1 with SL+TP)
# MAX_POSITIONS=1                # Non-MNQ fallback
# MNQ_MAX_POSITIONS=4            # MNQ concurrent cap (also max_positions_mnq in mnq_profit_config.json)
# Orphan SL/TP cleanup on live startup when list_orders exceeds threshold (0=disable)
# ORPHAN_ORDER_THRESHOLD=10
# Block new entries when Rithmic list_positions net exceeds bot-tracked local count
# BROKER_POSITION_BLOCK=true
# Minutes to block new entries on a symbol after SL or MAX_LOSS (default 10)
LOSS_COOLDOWN_MINUTES=10
# Pause new trades when daily loss reaches this fraction of symbol daily limit ($300 → stop at -$150)
DAILY_HALF_STOP=true
DAILY_HALF_STOP_PCT=0.5
# Per-symbol $ risk overrides (optional; defaults in start_live_mtf_scalping SYMBOL_SPECS)
# NQ_MAX_LOSS_PER_TRADE=250
# NQ_DAILY_LOSS_LIMIT=300
# MNQ_MAX_LOSS_PER_TRADE=250
# Scan loop: faster when holding a position (seconds)
SCAN_SLEEP_OPEN_SEC=5
SCAN_SLEEP_IDLE_SEC=10
# Min seconds between new entries on same symbol (0 = no gap; 30 = one per ~1m bar max)
# MIN_SECONDS_BETWEEN_ENTRIES=0
# Sub-minute trigger bars — Rithmic SECOND_BAR history (tick fallback if unavailable)
# USE_30S_BARS=true
# TRIGGER_BAR_SECONDS=30
# RITHMIC_SECOND_BAR_TIMEOUT=60       # outer timeout per SECOND_BAR attempt (session-open)
# RITHMIC_SECOND_BAR_RETRIES=3        # retries when history plant is slow at open
# SCALP_30S_FALLBACK_1M=true          # hybrid: use 1M trigger when 30s bars unavailable
# Force market exit after N seconds in trade (0 = disabled; SL/TP brackets still apply until then)
# For 15–30s scalping use 3–5 for SCAN_SLEEP_OPEN_SEC so the bot checks often enough.
# MAX_HOLD_SECONDS=30
# Breakeven / trail — hybrid scalp only. Locked ema15_eod forces these OFF.
# ema15_eod profit mode forces these off even if set true here
SCALP_BREAKEVEN_ENABLED=true
SCALP_BREAKEVEN_PCT=0.4
SCALP_BREAKEVEN_OFFSET_PTS=0.25
SCALP_SECURE_PROFIT_PCT=0.75
SCALP_TRAIL_AFTER_BE=true
# SCALP_TRAIL_MFE_LOCK_PCT=0.25
# SCALP_SECURE_LOCK_PCT=0.5
# SCALP_MAX_HOLD_TIGHTEN_PCT=0.85
# Paper mode: Databento 1m + data/MNQ_1m.csv (no Rithmic, no Yahoo). Orders simulated locally.
# PAPER_USE_RITHMIC=true              # overnight paper research sets this so the ticker is used
# Paper overnight Globex research (NOT live; does not set OVERNIGHT_TRADING on ema15_eod):
#   Use start_mnq_overnight_paper.bat — submits Lucid TEST/sim orders (not local fake fills).
#   PAPER_OVERNIGHT=true
#   python start_live_mtf_scalping.py --paper --overnight-research
# Close Lucid / R|Trader desktop first — Rithmic often allows only one session.
# Stop start_mnq_live.bat first (Ctrl+C). Two sessions on one Lucid login = ForcedLogout.
# Overnight path forces PAPER_RITHMIC_BRACKETS=true (ticker+order, live_mode=False, skip history/pnl).
# PAPER_TEST_FILL stays false unless you pass --paper-test-fill.
# PAPER_RITHMIC_BRACKETS=false

# MNQ action desk (http://127.0.0.1:5055) — live bot auto-starts it; or .\start_mnq_desk.bat
DASHBOARD=true
DASHBOARD_PORT=5055
LOG_LEVEL=INFO

# Email Notifications (optional — trade placed / closed / alerts)
# Set EMAIL_ON_TRADE=true and fill SMTP creds to receive emails on each order.
EMAIL_ON_TRADE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_TO=your_email@gmail.com
# EMAIL_FROM=your_email@gmail.com   # optional; defaults to SMTP_USER
