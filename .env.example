# ============================================================
# AI Forex Trading Bot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- MetaTrader 5 Credentials (Windows only) ---
MT5_ACCOUNT=YOUR_MT5_ACCOUNT_NUMBER
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=Exness-MT5

# --- Trading Mode ---
# Options: 'paper' (virtual money), 'live' (real money), 'backtest'
TRADING_MODE=paper

# --- Risk Management ---
RISK_PER_TRADE_PERCENT=1.0
MAX_CONCURRENT_TRADES=3
DAILY_LOSS_LIMIT_PERCENT=10
INITIAL_BALANCE=50

# --- AI Settings ---
ENSEMBLE_CONFIDENCE_THRESHOLD=0.75
MIN_MODELS_AGREEMENT=3

# --- News API ---
# Get free key: https://newsapi.org/register
NEWSAPI_KEY=YOUR_NEWSAPI_KEY

# --- Logging ---
LOG_LEVEL=INFO

# --- Dashboard ---
DASHBOARD_PORT=5000

# Logging
LOG_LEVEL=INFO
