# ============================================================
# AI Forex Trading Bot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- MetaTrader 5 Credentials (Windows only) ---
MT5_ACCOUNT=YOUR_MT5_ACCOUNT_NUMBER
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=Exness-MT5

# --- Trading Mode ---
# Options: 'paper' (virtual money), 'live' (real money), 'backtest'
TRADING_MODE=paper

# --- Risk Management ---
RISK_PER_TRADE_PERCENT=1.0
MAX_CONCURRENT_TRADES=3
DAILY_LOSS_LIMIT_PERCENT=10
INITIAL_BALANCE=50

# --- AI Settings ---
ENSEMBLE_CONFIDENCE_THRESHOLD=0.55
MIN_MODELS_AGREEMENT=3
MICRO_TAKE_PROFIT_RATIO=1.5
HIGH_CERTAINTY_THRESHOLD=0.70
SIGNAL_COOLDOWN_MINUTES=4

# Optional guards
ENABLE_CORRELATION_GUARD=false

# USD/JPY Pair-Specific Tuning
USDJPY_TUNING_ENABLED=true
USDJPY_MIN_CONFIDENCE=0.40
USDJPY_MIN_MODELS_AGREEMENT=2
USDJPY_MIN_ADX=25

# --- News API ---
# Get free key: https://newsapi.org/register
NEWSAPI_KEY=YOUR_NEWSAPI_KEY

# --- Logging ---
LOG_LEVEL=INFO

# --- Dashboard ---
DASHBOARD_PORT=5000

# Logging
LOG_LEVEL=INFO
