# Broker type: "mt5" (forex), "rithmic" (futures direct), "traderspost" (futures webhook)
BROKER_TYPE=mt5
# Asset class: "forex" or "futures"
ASSET_CLASS=forex

# MT5 Connection (fill in your account details)
MT5_ACCOUNT=YOUR_ACCOUNT_NUMBER
MT5_PASSWORD=YOUR_PASSWORD
MT5_SERVER=YOUR_SERVER

# Optional: only needed if running bot on Linux with relay
MT5_RELAY_URL=
MT5_RELAY_TOKEN=

# News API (optional)
NEWSAPI_KEY=

# Risk Management
RISK_PER_TRADE_PERCENT=1.0
MAX_CONCURRENT_TRADES=3
DAILY_LOSS_LIMIT_PERCENT=10
INITIAL_BALANCE=50
FIXED_LOT_SIZE=0.02

# Signal Thresholds
ENSEMBLE_CONFIDENCE_THRESHOLD=0.50
MIN_MODELS_AGREEMENT=2
SIGNAL_COOLDOWN_MINUTES=5
ENABLE_CORRELATION_GUARD=false

# Rithmic Connection (direct futures — recommended for Lucid/TradeSea)
# Get credentials from your TradeSea/Lucid account
RITHMIC_USER_ID=
RITHMIC_PASSWORD=
RITHMIC_SYSTEM=Rithmic Paper Trading
# RITHMIC_GATEWAY=  # Leave empty to auto-detect from system name

# Trading Mode: 'live', 'paper', 'backtest'
TRADING_MODE=live

# Dashboard
DASHBOARD_PORT=5001
LOG_LEVEL=INFO
