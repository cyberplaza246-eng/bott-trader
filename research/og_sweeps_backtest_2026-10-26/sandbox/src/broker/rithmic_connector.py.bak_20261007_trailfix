    def _get_watch_symbols(self) -> List[str]:
        """Return symbols to subscribe, from config or defaults."""
        if self._symbols_to_watch:
            return self._symbols_to_watch
        from config.strategy_config import PAIRS, ASSET_CLASS
        if ASSET_CLASS == "futures":
            return [s for s in PAIRS if s in RITHMIC_SYMBOL_MAP]
        return []

    def _resolve_symbol_raw(self, symbol: str) -> tuple:
        """Map our symbol name → (rithmic_base_symbol, exchange)."""
        entry = RITHMIC_SYMBOL_MAP.get(symbol)
        if entry:
            return entry
        # Pass through if already a rithmic symbol
        return (symbol, "CME")

    def _resolve_symbol(self, symbol: str) -> tuple:
        """Map our symbol → (resolved_trading_symbol, exchange)."""
        _, exchange = self._resolve_symbol_raw(symbol)
        if symbol in self._resolved_contracts:
            return (self._resolved_contracts[symbol], exchange)

        override = self._contract_overrides.get(symbol)
        if override:
            self._resolved_contracts[symbol] = override
            return (override, exchange)

        parsed = self._parse_explicit_contract(symbol)
        if parsed:
            base, contract = parsed
            if base == symbol or symbol in RITHMIC_SYMBOL_MAP:
                self._resolved_contracts[symbol] = contract
                return (contract, exchange)

        trading_sym = RITHMIC_SYMBOL_MAP.get(symbol, (symbol,))[0]
        return (trading_sym, exchange)

    def _reverse_resolve(self, trading_symbol: str) -> str:
        """Reverse-map a Rithmic trading symbol back to our symbol."""
        for our_sym, rith_sym in self._resolved_contracts.items():
            if rith_sym == trading_symbol:
                return our_sym
        # Try matching base symbol (e.g., "MESH6" starts with "MES")
        for our_sym, (base, _) in RITHMIC_SYMBOL_MAP.items():
            if trading_symbol.startswith(base) and len(trading_symbol) > len(base):
                return our_sym
        return trading_symbol

    @staticmethod
    def _is_simulator_route_name(route: str) -> bool:
        name = str(route or "").lower()
        return "simulator" in name or name in {"sim", "paper", "demo"}

    @staticmethod
    def _is_pro004_account(account_id: str) -> bool:
        return "PRO004" in str(account_id or "").upper()

    def _pro004_sim_mode_active(self) -> bool:
        acct = self._get_account_id() or self._account_id_override or ""
        return (
            self._using_simulator_route
            and self._allow_simulator_route
            and self._is_pro004_account(acct)
        )

    def _print_pro004_sim_mode_banner(self) -> None:
        msg = (
            "PRO004 SIM MODE — orders via Rithmic simulator until Lucid enables live route"
        )
        banner = f"\n   {'═' * 60}\n   {msg}\n   {'═' * 60}\n"
        bot_logger.warning(msg)
        print(banner)

    @staticmethod
    def _route_sort_key(route_obj: Any, *, preferred: str = "", reject_simulator: bool) -> tuple:
        route_name = str(getattr(route_obj, "trade_route", "") or "")
        lower = route_name.lower()
        is_sim = RithmicConnector._is_simulator_route_name(route_name)
        is_default = bool(getattr(route_obj, "is_default", False))
        if preferred and lower == preferred.lower():
            return (0, 0 if not is_sim else 1, route_name)
        if is_default and not is_sim:
            return (1, 0, route_name)
        if not is_sim and reject_simulator:
            return (2, 0, route_name)
        if is_default:
            return (3, 1 if is_sim else 0, route_name)
        if not is_sim:
            return (4, 0, route_name)
        return (5, 0, route_name)

    def _prioritize_trade_routes(self, routes: List[Any]) -> List[Any]:
        """Reorder async_rithmic trade routes so submit_order picks the intended route."""
        preferred = self._trade_route_override
        reject_sim = self._live_mode and not self._allow_simulator_route and not preferred
        by_exchange: Dict[str, List[Any]] = {}
        for route_obj in routes or []:
            exchange = str(getattr(route_obj, "exchange", "") or "")
            by_exchange.setdefault(exchange, []).append(route_obj)

        prioritized: List[Any] = []
        for exchange in sorted(by_exchange):
            sorted_routes = sorted(
                by_exchange[exchange],
                key=lambda r: self._route_sort_key(
                    r, preferred=preferred, reject_simulator=reject_sim,
                ),
            )
            prioritized.extend(sorted_routes)
            if sorted_routes:
                chosen = str(getattr(sorted_routes[0], "trade_route", "") or "")
                self._routes_by_exchange[exchange] = chosen
        return prioritized

    def _select_account_id(self, accounts: List[Any]) -> Optional[str]:
        if self._account_id_override and not accounts:
            # Lucid sometimes returns routes but an empty account list on
            # ticker+order-only connects — still honor .env account for sim.
            bot_logger.warning(
                f"Rithmic accounts empty — using RITHMIC_ACCOUNT_ID="
                f"{self._account_id_override!r}"
            )
            return self._account_id_override
        if not accounts:
            return None
        if self._account_id_override:
            for acct in accounts:
                acct_id = str(getattr(acct, "account_id", "") or "")
                if acct_id == self._account_id_override:
                    return acct_id
            bot_logger.warning(
                f"RITHMIC_ACCOUNT_ID={self._account_id_override!r} not in "
                f"broker list {[getattr(a, 'account_id', '') for a in accounts]} "
                f"— using first matching demo/sim account instead"
            )
            # Fall through to demo preference rather than force a stale TEST011 id.

        def _label(acct: Any) -> str:
            return (
                f"{getattr(acct, 'account_id', '')} "
                f"{getattr(acct, 'account_name', '')}"
            ).lower()

        # Paper / simulator: prefer accounts named demo/sim over stale TEST* ids.
        if not self._live_mode or self._allow_simulator_route:
            for needle in ("demo", "sim", "paper", "sandbox"):
                for acct in accounts:
                    if needle in _label(acct):
                        aid = str(getattr(acct, "account_id", "") or "")
                        if aid:
                            bot_logger.info(
                                f"Rithmic account auto-select ({needle}): {aid}"
                            )
                            return aid

        if len(accounts) == 1:
            return str(getattr(accounts[0], "account_id", "") or "") or None

        if self._live_mode:
            for acct in accounts:
                acct_id = str(getattr(acct, "account_id", "") or "")
                acct_name = str(getattr(acct, "account_name", "") or "").lower()
                if "sim" not in acct_id.lower() and "sim" not in acct_name:
                    return acct_id
        return str(getattr(accounts[0], "account_id", "") or "") or None

    async def _async_configure_execution(self) -> None:
        """Resolve account + trade routes after connect; async_rithmic defaults to routes[0]."""
        order_plant = self._client.plants["order"]
        accounts = list(order_plant.accounts or [])
        routes = list(order_plant.trade_routes or [])

        acct_lines = [
            f"{getattr(a, 'account_id', '?')} "
            f"({getattr(a, 'account_name', '') or 'unnamed'})"
            for a in accounts
        ]
        route_lines = [
            f"{getattr(r, 'exchange', '?')}: {getattr(r, 'trade_route', '?')} "
            f"default={getattr(r, 'is_default', False)} "
            f"status={getattr(r, 'status', '')}"
            for r in routes
        ]
        bot_logger.info(
            f"Rithmic accounts ({len(accounts)}): {acct_lines or ['none']}"
        )
        bot_logger.info(
            f"Rithmic trade routes ({len(routes)}): {route_lines or ['none']}"
        )

        self._selected_account_id = self._select_account_id(accounts)
        if self._selected_account_id and accounts:
            order_plant.accounts = sorted(
                accounts,
                key=lambda a: 0 if getattr(a, "account_id", "") == self._selected_account_id else 1,
            )

        if routes:
            order_plant.trade_routes = self._prioritize_trade_routes(routes)

        self._using_simulator_route = any(
            self._is_simulator_route_name(route_name)
            for route_name in self._routes_by_exchange.values()
        )

        primary_route = self._routes_by_exchange.get("CME") or next(
            iter(self._routes_by_exchange.values()), ""
        )
        bot_logger.info(
            f"Rithmic execution: account_id={self._selected_account_id} "
            f"trade_route(CME)={primary_route} live_mode={self._live_mode}"
        )
        if self._using_simulator_route and self._live_mode:
            if self._pro004_sim_mode_active():
                self._print_pro004_sim_mode_banner()
            else:
                msg = (
                    "ORDERS GOING TO SIMULATOR NOT LIVE — "
                    f"account_id={self._selected_account_id} trade_route={primary_route}. "
                    "Set RITHMIC_TRADE_ROUTE to your Lucid live route (not 'simulator')."
                )
                bot_logger.error(msg)
                print(f"\n   🚨🚨🚨 {msg} 🚨🚨🚨\n")

    def _get_account_id(self) -> Optional[str]:
        """Return configured account ID (RITHMIC_ACCOUNT_ID or resolved default)."""
        if self._selected_account_id:
            return self._selected_account_id
        if self._account_id_override:
            return self._account_id_override
        if self._client and self._client.accounts:
            return self._client.accounts[0].account_id
        return None

    def confirm_bracket_exit_fill(
        self,
        order_id: str,
        symbol: str,
        stop_loss: float,
        take_profit: float,
        *,
        force_sync: bool = False,
        flat_duration_sec: float = 0.0,
        entry_price: float = 0.0,
    ) -> Optional[Dict[str, Any]]:
        """Return fill details when broker confirms bracket exit; None if unconfirmed."""
        if not self._connected:
            return None
        try:
            return self._run_sync(
                self._async_confirm_bracket_exit_fill(
                    order_id,
                    symbol,
                    stop_loss,
                    take_profit,
                    force_sync=force_sync,
                    flat_duration_sec=flat_duration_sec,
                    entry_price=entry_price,
                ),
                timeout=15,
            )
        except Exception as e:
            error_logger.error(f"confirm_bracket_exit_fill error for {order_id}: {e}")
            return None

    def acknowledge_flat_position(self, order_id: str, symbol: str) -> None:
        """Drop local order tracking after bot force-syncs a broker-flat position."""
        oid = str(order_id)
        self.remember_closed_entry(oid, symbol)

        def _exc(exc: BaseException) -> str:
            msg = str(exc).strip()
            if msg:
                return msg
            return type(exc).__name__

        try:
            self._run_sync(
                self._async_cancel_remaining_bracket_legs(
                    oid,
                    symbol,
                    reason="ack_flat",
                    force=True,
                ),
                timeout=8,
            )
        except Exception as e:
            # Never block the hunt loop on cancel failures after an exit.
            error_logger.error(
                f"Cancel bracket legs on ack_flat failed for {oid} {symbol}: {_exc(e)}"
            )
        with self._order_lock:
            removed = self._orders.pop(oid, None)
        if removed:
            bot_logger.info(
                f"🔄 Order {oid} ({symbol}) cleared — bot force-synced flat broker state"
            )
        try:
            cancelled = self._run_sync(
                self._async_cancel_orphan_protective_if_flat(symbol),
                timeout=8,
            )
            if cancelled:
                bot_logger.info(
                    f"{symbol}: cancelled {cancelled} orphan protective order(s) on ack_flat"
                )
        except Exception as e:
            error_logger.error(
                f"Orphan protective cleanup on ack_flat failed for {symbol}: {_exc(e)}"
            )
        try:
            self._refresh_positions()
        except Exception:
            pass

    def _bracket_leg_ids(self, order_id: str) -> Tuple[List[str], List[str]]:
        with self._order_lock:
            order = self._orders.get(order_id, {})
            sl_ids = [
                order.get("protective_sl_order_id"),
                f"{order_id}_sl",
            ]
            tp_ids = [
                order.get("protective_tp_order_id"),
                f"{order_id}_tp",
                f"{order_id}_tp_lit",
            ]
            closed_rec = self._closed_entry_registry().get(str(order_id)) or {}
            for leg in closed_rec.get("legs") or ():
                if leg.endswith("_sl") and leg not in sl_ids:
                    sl_ids.append(leg)
                elif leg not in tp_ids and leg not in sl_ids:
                    tp_ids.append(leg)
        return (
            [leg_id for leg_id in sl_ids if leg_id],
            [leg_id for leg_id in tp_ids if leg_id],
        )

    async def _async_classify_protective_leg(self, leg_id: str) -> str:
        """Return filled, working, cancelled, terminal, or missing."""
        if not leg_id:
            return "missing"
        order = await self._async_get_order_snapshot(leg_id)
        if not order:
            return "missing"
        if self._is_filled_order_snapshot(order):
            return "filled"
        status = str(getattr(order, "status", "") or "").lower()
        if status in {"cancelled", "canceled", "rejected", "expired", "inactive"}:
            return "cancelled"
        if self._is_working_order_status(status):
            return "working"
        return "terminal"

    async def _async_diagnose_bracket_legs(
        self,
        order_id: str,
        stop_loss: float,
        take_profit: float,
    ) -> Dict[str, Any]:
        """Inspect SL/TP legs when broker is flat but fill is not confirmed."""
        sl_ids, tp_ids = self._bracket_leg_ids(order_id)
        leg_statuses: Dict[str, str] = {}
        for leg_id in sl_ids + tp_ids:
            leg_statuses[leg_id] = await self._async_classify_protective_leg(leg_id)

        if any(status == "filled" for status in leg_statuses.values()):
            return {"inferred_flat": False}

        if any(status == "working" for status in leg_statuses.values()):
            return {"inferred_flat": False, "legs_working": True}

        if not leg_statuses:
            entry = await self._async_get_order_snapshot(order_id)
            if entry and self._is_filled_order_snapshot(entry):
                with self._order_lock:
                    info = self._orders.get(order_id, {})
                    sl = float(info.get("stop_loss") or stop_loss or 0)
                    tp = float(info.get("take_profit") or take_profit or 0)
                sl_ok, tp_ok = await self._async_query_broker_protection(order_id, sl, tp)
                if sl_ok or tp_ok:
                    return {"inferred_flat": False, "legs_working": True}
                if self._order_within_entry_grace(order_id):
                    return {"inferred_flat": False}
                return {
                    "inferred_flat": True,
                    "sync_reason": "BROKER_SYNC",
                    "leg": "SYNC",
                    "detail": "entry filled, protective legs absent, broker flat",
                }
            return {"inferred_flat": False}

        cancelled = sum(1 for s in leg_statuses.values() if s == "cancelled")
        terminal = sum(1 for s in leg_statuses.values() if s in {"cancelled", "terminal", "missing"})
        if terminal >= len(leg_statuses):
            with self._order_lock:
                info = self._orders.get(order_id, {})
                sl = float(info.get("stop_loss") or stop_loss or 0)
                tp = float(info.get("take_profit") or take_profit or 0)
            sl_ok, tp_ok = await self._async_query_broker_protection(order_id, sl, tp)
            if sl_ok or tp_ok:
                return {"inferred_flat": False, "legs_working": True}
            detail = (
                f"legs cancelled/terminal ({cancelled} cancelled of {len(leg_statuses)})"
            )
            return {
                "inferred_flat": True,
                "sync_reason": "BROKER_SYNC",
                "leg": "SYNC",
                "detail": detail,
                "leg_statuses": leg_statuses,
            }

        return {"inferred_flat": False, "leg_statuses": leg_statuses}

    def _resolve_inferred_exit_price(
        self,
        symbol: str,
        stop_loss: float,
        take_profit: float,
        *,
        entry_price: float = 0.0,
    ) -> float:
        exit_price = self._get_cached_price(symbol)
        if exit_price > 0:
            return exit_price
        if entry_price > 0:
            return entry_price
        if stop_loss > 0 and take_profit > 0:
            return (stop_loss + take_profit) / 2.0
        return stop_loss or take_profit or 0.0

    async def _async_confirm_bracket_exit_fill(
        self,
        order_id: str,
        symbol: str,
        stop_loss: float,
        take_profit: float,
        *,
        force_sync: bool = False,
        flat_duration_sec: float = 0.0,
        entry_price: float = 0.0,
    ) -> Optional[Dict[str, Any]]:
        if self._order_within_entry_grace(order_id):
            bot_logger.debug(
                f"Bracket exit {order_id} {symbol}: entry grace active — "
                f"not confirming exit or cancelling SL/TP"
            )
            return None

        entry_open = await self._async_is_entry_still_open(order_id, symbol)
        if entry_open is None:
            return None
        if entry_open:
            listed_fill = await self._async_listed_protective_fill_for_entry(order_id, symbol)
            if listed_fill:
                entry_open = False
            elif not force_sync:
                return None

        with self._order_lock:
            cached = dict(self._confirmed_exit_fills.get(order_id, {}))
        if cached.get("confirmed"):
            return cached

        exit_price = 0.0
        leg = ""
        sl_ids, tp_ids = self._bracket_leg_ids(order_id)

        with self._order_lock:
            _live = self._orders.get(order_id) or {}
            stop_loss = float(_live.get("stop_loss") or stop_loss or 0)
            take_profit = float(_live.get("take_profit") or take_profit or 0)
        for leg_id in sl_ids:
            if leg_id and await self._async_is_leg_filled(leg_id):
                exit_price = await self._async_leg_fill_price(leg_id, stop_loss)
                leg = "SL"
                break

        if not leg:
            for leg_id in tp_ids:
                if leg_id and await self._async_is_leg_filled(leg_id):
                    exit_price = await self._async_leg_fill_price(leg_id, take_profit)
                    leg = "TP"
                    break

        if leg:
            fill_from_broker = exit_price > 0
            if not fill_from_broker:
                bot_logger.warning(
                    f"Bracket exit {order_id} {symbol}: leg {leg} filled but no fill price on "
                    f"order snapshot — using bracket level fallback"
                )
                exit_price = take_profit if leg == "TP" else stop_loss

            result = {
                "confirmed": True,
                "inferred": False,
                "exit_price": exit_price,
                "leg": leg,
                "sync_reason": "BROKER_BRACKET",
                "fill_from_broker": fill_from_broker,
                "account_id": self._get_account_id(),
                "trade_route": self.get_trade_route("CME"),
            }
            with self._order_lock:
                self._confirmed_exit_fills[order_id] = result
            # force=True: do not re-check still_open (working sibling STOP-LIMIT
            # would otherwise look "still open" and skip cancel after TP/SL fill).
            await self._async_cancel_remaining_bracket_legs(
                order_id,
                symbol,
                reason="bracket_exit_confirmed",
                force=True,
            )
            return result

        diagnosis = await self._async_diagnose_bracket_legs(
            order_id, stop_loss, take_profit,
        )
        if diagnosis.get("legs_working"):
            if (
                _ALLOW_FLAT_ORPHAN_WIPE
                and force_sync and flat_duration_sec >= _BROKER_FLAT_FORCE_SYNC_SEC
            ):
                listed_net = await self._async_list_positions_net_or_none(symbol)
                if listed_net is not None and int(listed_net) == 0:
                    await self._async_cancel_working_orders_after_exit(
                        symbol,
                        order_id,
                        reason="bracket_exit_orphan_wipe",
                        already_flat=True,
                    )
                    still_open = await self._async_is_entry_still_open(order_id, symbol)
                    if still_open is False:
                        exit_price = self._resolve_inferred_exit_price(
                            symbol, stop_loss, take_profit, entry_price=entry_price,
                        )
                        result = {
                            "confirmed": True,
                            "inferred": True,
                            "force_sync": True,
                            "exit_price": exit_price,
                            "leg": "UNKNOWN",
                            "sync_reason": "ORPHAN_WIPE",
                            "fill_from_broker": exit_price > 0 and self._get_cached_price(symbol) > 0,
                            "detail": (
                                f"orphan wipe after {flat_duration_sec:.0f}s flat "
                                f"with working legs listed"
                            ),
                            "account_id": self._get_account_id(),
                            "trade_route": self.get_trade_route("CME"),
                        }
                        bot_logger.warning(
                            f"Bracket exit {order_id} {symbol}: orphan-wipe force-sync "
                            f"@ {exit_price:.2f} after {flat_duration_sec:.0f}s flat"
                        )
                        with self._order_lock:
                            self._confirmed_exit_fills[order_id] = result
                        await self._async_cancel_remaining_bracket_legs(
                            order_id,
                            symbol,
                            reason="bracket_exit_orphan_wipe",
                            force=True,
                        )
                        return result
            route_note = (
                "simulator list_positions often empty despite open fill + SL/TP"
                if self._using_simulator_route
                else "working SL/TP without confirmed fill"
            )
            bot_logger.info(
                f"Bracket exit {order_id} {symbol}: broker flat with working legs — "
                f"keeping protection ({route_note})"
            )
            return None
        if diagnosis.get("inferred_flat"):
            exit_price = self._resolve_inferred_exit_price(
                symbol, stop_loss, take_profit, entry_price=entry_price,
            )
            sync_reason = str(diagnosis.get("sync_reason") or "BROKER_SYNC")
            result = {
                "confirmed": True,
                "inferred": True,
                "exit_price": exit_price,
                "leg": diagnosis.get("leg", "SYNC"),
                "sync_reason": sync_reason,
                "fill_from_broker": exit_price > 0 and self._get_cached_price(symbol) > 0,
                "detail": diagnosis.get("detail", ""),
                "account_id": self._get_account_id(),
                "trade_route": self.get_trade_route("CME"),
            }
            bot_logger.warning(
                f"Bracket exit {order_id} {symbol}: inferred flat — {sync_reason} "
                f"@ {exit_price:.2f} ({diagnosis.get('detail', 'legs terminal without fill')})"
            )
            with self._order_lock:
                self._confirmed_exit_fills[order_id] = result
            await self._async_cancel_remaining_bracket_legs(
                order_id,
                symbol,
                reason="bracket_exit_inferred",
            )
            return result

        if force_sync:
            still_open = await self._async_is_entry_still_open(order_id, symbol)
            listed_net = await self._async_list_positions_net_or_none(symbol)
            legs_working = False
            sl_ids, tp_ids = self._bracket_leg_ids(order_id)
            for leg_id in sl_ids + tp_ids:
                if leg_id and await self._async_is_order_working(leg_id):
                    legs_working = True
                    break
            # Manual flatten: list flat + no working SL/TP → clear local even if
            # the filled entry tag still looks "open" on simulator.
            manual_flat = (
                listed_net is not None
                and int(listed_net) == 0
                and not legs_working
            )
            if still_open is True and not manual_flat:
                if (
                    _ALLOW_FLAT_ORPHAN_WIPE
                    and listed_net is not None and int(listed_net) == 0
                ):
                    await self._async_cancel_working_orders_after_exit(
                        symbol,
                        order_id,
                        reason="bracket_exit_force_sync_orphans",
                        already_flat=True,
                    )
                    still_open = await self._async_is_entry_still_open(order_id, symbol)
                    legs_working = False
                    for leg_id in sl_ids + tp_ids:
                        if leg_id and await self._async_is_order_working(leg_id):
                            legs_working = True
                            break
                    manual_flat = not legs_working
                if still_open is True and not manual_flat:
                    route_note = (
                        "simulator route — list_positions often empty despite open sim fills"
                        if self._using_simulator_route
                        else "entry filled with working SL/TP"
                    )
                    bot_logger.warning(
                        f"Bracket exit {order_id} {symbol}: skipping force-sync — "
                        f"{route_note} (flat {flat_duration_sec:.0f}s)"
                    )
                    return None
            if still_open is None and not manual_flat:
                bot_logger.info(
                    f"Bracket exit {order_id} {symbol}: force-sync pending — "
                    f"entry state unknown (flat {flat_duration_sec:.0f}s)"
                )
                return None
            exit_price = self._resolve_inferred_exit_price(
                symbol, stop_loss, take_profit, entry_price=entry_price,
            )
            sync_reason = "MANUAL_CLOSE" if manual_flat else "UNKNOWN"
            result = {
                "confirmed": True,
                "inferred": True,
                "force_sync": True,
                "exit_price": exit_price,
                "leg": "MANUAL" if manual_flat else "UNKNOWN",
                "sync_reason": sync_reason,
                "fill_from_broker": exit_price > 0 and self._get_cached_price(symbol) > 0,
                "detail": (
                    f"manual/broker flat after {flat_duration_sec:.0f}s "
                    f"(no working SL/TP, list_net={listed_net})"
                    if manual_flat
                    else f"force-sync after {flat_duration_sec:.0f}s broker-flat"
                ),
                "account_id": self._get_account_id(),
                "trade_route": self.get_trade_route("CME"),
            }
            bot_logger.warning(
                f"Bracket exit {order_id} {symbol}: force-sync {sync_reason} @ {exit_price:.2f} "
                f"after {flat_duration_sec:.0f}s flat ({result.get('detail')})"
            )
            with self._order_lock:
                self._confirmed_exit_fills[order_id] = result
            await self._async_cancel_remaining_bracket_legs(
                order_id,
                symbol,
                reason="bracket_exit_force_sync",
            )
            return result

        bot_logger.warning(
            f"Bracket exit for {order_id} {symbol} — position flat but no SL/TP fill "
            f"confirmed on broker; not reporting BROKER_BRACKET close "
            f"(flat {flat_duration_sec:.0f}s, force_sync={force_sync})"
        )
        return None

    def _remember_detected_exit_fill(
        self, entry_id: str, leg: Any, price: Any, leg_order_id: str = "",
    ) -> None:
        """Record a detected SL/TP fill unless one is already confirmed (keeps real PnL)."""
        try:
            px = float(price or 0)
        except (TypeError, ValueError):
            px = 0.0
        leg = str(leg or "").upper()
        if px <= 0 or leg not in ("SL", "TP"):
            return
        with self._order_lock:
            if (self._confirmed_exit_fills.get(entry_id) or {}).get("confirmed"):
                return
        self._record_exit_fill(entry_id, leg, px, leg_order_id)
        bot_logger.info(f"Detected bracket {leg} fill for {entry_id} @ {px:.2f} (recorded for PnL)")

    def _record_exit_fill(
        self,
        entry_id: str,
        leg: str,
        fill_price: float,
        leg_order_id: str,
    ) -> None:
        with self._order_lock:
            self._confirmed_exit_fills[entry_id] = {
                "confirmed": True,
                "exit_price": fill_price,
                "leg": leg,
                "leg_order_id": leg_order_id,
                "account_id": self._get_account_id(),
                "trade_route": self.get_trade_route("CME"),
            }

    def _get_cached_price(self, symbol: str) -> float:
        """Get current cached price for a symbol."""
        with self._quote_lock:
            quote = self._quotes.get(symbol, {})
            if quote.get("last", 0) > 0:
                return quote["last"]
            if quote.get("bid", 0) > 0 and quote.get("ask", 0) > 0:
                return (quote["bid"] + quote["ask"]) / 2
        return 0.0

    def _refresh_positions(self) -> None:
        """Sync positions from Rithmic PnL plant."""
        if not self._connected:
            return
        try:
            positions = self._run_sync(
                self._async_list_positions(),
                timeout=10,
            )
            if positions is None:
                return
            updated: Dict[str, Any] = {}
            for p in positions:
                data = _response_to_dict_safe(p)
                symbol = data.get("symbol", "")
                our_sym = self._reverse_resolve(symbol)
                qty = self._position_qty_from_broker_data(data)
                if qty != 0:
                    updated[our_sym] = {
                        "symbol": our_sym,
                        "size": qty,
                        "avg_price": float(data.get("avg_open_fill_price", 0)),
                        "unrealized_pnl": float(data.get("open_pnl", 0)),
                    }

            with self._state_lock:
                for sym in list(self._positions.keys()):
                    if sym not in updated:
                        del self._positions[sym]
                self._positions.update(updated)

            self._cleanup_closed_orders()

        except Exception as e:
            error_logger.error(f"Rithmic refresh positions error: {e}")

    async def _async_entry_has_working_legs(self, order_id: str, symbol: str) -> Optional[bool]:
        """True if any SL/TP for this entry is working (tagged, cached basket, or adopted)."""
        sl_ids, tp_ids = self._bracket_leg_ids(order_id)
        for leg_id in sl_ids + tp_ids:
            if leg_id and await self._async_is_order_working(leg_id):
                return True
        rebound = (await self._async_rebind_symbol_legs(symbol)).get(str(order_id))
        if rebound is None:
            return None
        return bool(rebound.get("sl_working") or rebound.get("tp_working"))

    def _legs_gone_since(self) -> Dict[str, float]:
        reg = getattr(self, "_legs_gone_first_seen", None)
        if reg is None:
            reg = {}
            self._legs_gone_first_seen = reg
        return reg

    def _legs_gone_passes(self) -> Dict[str, int]:
        reg = getattr(self, "_legs_gone_pass_count", None)
        if reg is None:
            reg = {}
            self._legs_gone_pass_count = reg
        return reg

    def _legs_gone_reset(self, oid: str) -> None:
        self._legs_gone_since().pop(str(oid), None)
        self._legs_gone_passes().pop(str(oid), None)

    def _legs_gone_confirmed(self, oid: str) -> bool:
        """Legs must stay gone for _LEGS_GONE_CONFIRM_SEC AND N consecutive passes."""
        oid = str(oid)
        passes = self._legs_gone_passes()
        passes[oid] = int(passes.get(oid, 0)) + 1
        if _LEGS_GONE_CONFIRM_SEC <= 0 and _LEGS_GONE_CONFIRM_PASSES <= 1:
            return True
        reg = self._legs_gone_since()
        now = time.time()
        first = reg.setdefault(oid, now)
        return (
            now - first >= _LEGS_GONE_CONFIRM_SEC
            and passes[oid] >= max(1, _LEGS_GONE_CONFIRM_PASSES)
        )

    async def _async_find_exit_fill_for_entry(
        self, order_id: str, symbol: str,
    ) -> Optional[Dict[str, Any]]:
        """Broker-side SL/TP fill for THIS entry (tag, cached basket or adopted leg)."""
        with self._order_lock:
            info = dict(self._orders.get(order_id) or {})
        sl_px = float(info.get("stop_loss") or 0)
        tp_px = float(info.get("take_profit") or 0)
        try:
            listed = await self._async_listed_protective_fill_for_entry(order_id, symbol)
        except Exception:
            listed = None
        if listed and float(listed.get("exit_price") or 0) > 0:
            return {
                "leg": listed.get("leg") or "UNKNOWN",
                "exit_price": float(listed["exit_price"]),
                "leg_order_id": listed.get("user_tag") or listed.get("basket_id") or "",
            }
        sl_ids, tp_ids = self._bracket_leg_ids(order_id)
        for leg_name, ids, fb in (("SL", sl_ids, sl_px), ("TP", tp_ids, tp_px)):
            for leg_id in ids:
                try:
                    filled = leg_id and await self._async_is_leg_filled(leg_id)
                except Exception:
                    filled = False
                if not filled:
                    continue
                px = await self._async_leg_fill_price(leg_id, fb)
                if px > 0:
                    return {"leg": leg_name, "exit_price": float(px), "leg_order_id": leg_id}
        return None

    def recover_exit_fill(self, order_id: str, symbol: str) -> Optional[Dict[str, Any]]:
        """Public: real exit fill for an entry (cached confirm, else broker lookup)."""
        with self._order_lock:
            cached = dict((self._confirmed_exit_fills.get(order_id) or {}))
        if cached.get("confirmed") and float(cached.get("exit_price") or 0) > 0 and str(
            cached.get("leg") or ""
        ).upper() in ("TP", "SL"):
            return cached
        if not self._connected or not self._client:
            return None
        try:
            fill = self._run_sync(self._async_find_exit_fill_for_entry(order_id, symbol), timeout=20)
        except Exception as e:
            error_logger.error(f"recover_exit_fill failed for {order_id}: {e}")
            return None
        if not fill:
            return None
        self._record_exit_fill(order_id, fill["leg"], fill["exit_price"], fill.get("leg_order_id", ""))
        with self._order_lock:
            return dict(self._confirmed_exit_fills.get(order_id) or {})

    def entry_protection_live(self, order_id: str, symbol: str) -> Optional[bool]:
        """Public: True if any SL/TP of this entry is still working (None = unknown)."""
        if not self._connected or not self._client or not symbol:
            return None
        try:
            return self._run_sync(self._async_entry_has_working_legs(order_id, symbol), timeout=20)
        except Exception as e:
            error_logger.error(f"entry_protection_live failed for {order_id}: {e}")
            return None

    def _cleanup_try_record_exit_fill(self, oid: str, symbol: str) -> bool:
        """Look up a broker SL/TP fill for oid; record it (real PnL). True if found."""
        try:
            fill = self._run_sync(self._async_find_exit_fill_for_entry(oid, symbol), timeout=20)
        except Exception as e:
            error_logger.error(f"Exit fill lookup failed for {oid}: {e}")
            return False
        if not fill:
            return False
        self._record_exit_fill(oid, fill["leg"], fill["exit_price"], fill.get("leg_order_id", ""))
        bot_logger.info(
            f"{oid} ({symbol}): broker exit fill found {fill['leg']} @ {fill['exit_price']:.2f}"
        )
        return True

    def _cleanup_closed_orders(self) -> None:
        """Remove local order tracking only when broker confirms symbol is flat."""
        with self._order_lock:
            candidates = list(self._orders.items())

        for oid, info in candidates:
            symbol = info.get("symbol", "")
            if not symbol:
                continue

            if self._order_within_entry_grace(oid):
                bot_logger.debug(
                    f"Keeping SL/TP for {oid} — entry grace period active ({symbol})"
                )
                continue

            try:
                positions = self._run_sync(
                    self._async_list_positions(),
                    timeout=10,
                )
                if positions is None:
                    bot_logger.info(
                        f"Keeping SL/TP for {oid} — broker position unknown, skipping cleanup ({symbol})"
                    )
                    continue
                broker_net = self._list_positions_net_qty(positions, symbol)
            except Exception as e:
                if self._missing_plant_error(e):
                    self._log_missing_plant_once("pnl", "list_positions")
                    continue
                error_logger.error(
                    f"list_positions failed during cleanup for {symbol}: {e}"
                )
                bot_logger.info(
                    f"Keeping SL/TP for {oid} — broker position unknown, skipping cleanup ({symbol})"
                )
                continue

            with self._order_lock:
                exit_confirmed = bool(
                    (self._confirmed_exit_fills.get(oid) or {}).get("confirmed")
                )
            if broker_net != 0:
                # Another concurrent entry may keep the symbol open. An entry
                # whose own SL/TP fill is confirmed is closed regardless.
                others = self._tracked_bot_entry_ids(symbol) - {str(oid)}
                covered = abs(int(broker_net)) <= self._tracked_entry_qty(others)
                if not covered:
                    self._legs_gone_reset(str(oid))
                    bot_logger.debug(
                        f"Keeping SL/TP for {oid} — position still open on broker ({symbol})"
                    )
                    continue
                if not exit_confirmed:
                    # Early manual close of ONE of the concurrent trades: the
                    # remaining size is fully owned by the other entries and
                    # this entry has no working SL/TP left (after rebinding
                    # any user-adjusted legs). Otherwise keep tracking.
                    try:
                        legs_live = self._run_sync(
                            self._async_entry_has_working_legs(oid, symbol), timeout=20,
                        )
                    except Exception as e:
                        error_logger.error(f"Leg check failed during cleanup for {oid}: {e}")
                        legs_live = None
                    if legs_live is not False:
                        self._legs_gone_reset(str(oid))
                        continue
                    if not self._legs_gone_confirmed(str(oid)):
                        continue
                    exit_confirmed = self._cleanup_try_record_exit_fill(oid, symbol)
                    bot_logger.warning(
                        f"{oid} ({symbol}): broker net={broker_net} is covered by other "
                        f"entries and its SL/TP are gone — treating as "
                        f"{'closed by confirmed fill' if exit_confirmed else 'manually closed'}"
                    )
            elif not exit_confirmed:
                # list_positions == 0 is NOT evidence of a close on Lucid (sim
                # route reports 0 even right after a fill). Drop only on:
                #   (a) a confirmed SL/TP fill for THIS entry, or
                #   (b) its SL/TP gone for _LEGS_GONE_CONFIRM_SEC and N passes.
                if self._cleanup_try_record_exit_fill(oid, symbol):
                    exit_confirmed = True
                else:
                    try:
                        still_open = self._run_sync(
                            self._async_is_entry_still_open(oid, symbol),
                            timeout=20,
                        )
                    except Exception as e:
                        error_logger.error(
                            f"Entry open check failed during cleanup for {oid} {symbol}: {e}"
                        )
                        still_open = None
                    if still_open is True or still_open is None:
                        self._legs_gone_reset(str(oid))
                        bot_logger.debug(
                            f"Keeping SL/TP for {oid} — entry still open or unknown ({symbol})"
                        )
                        continue
                    if not self._legs_gone_confirmed(str(oid)):
                        bot_logger.info(
                            f"Keeping {oid} tracked — list_positions flat and SL/TP not "
                            f"visible; confirming {_LEGS_GONE_CONFIRM_SEC:.0f}s / "
                            f"{_LEGS_GONE_CONFIRM_PASSES} passes before release ({symbol})"
                        )
                        continue
                    # Last chance: a fill may have printed while we waited.
                    if self._cleanup_try_record_exit_fill(oid, symbol):
                        exit_confirmed = True

            if not exit_confirmed:
                # Hard guard: never cancel legs / drop an entry whose protection is
                # still working. Unknown also keeps (prefer tracked over wiped).
                try:
                    legs_live = self._run_sync(
                        self._async_entry_has_working_legs(oid, symbol), timeout=20,
                    )
                except Exception as e:
                    error_logger.error(f"Pre-release leg check failed for {oid}: {e}")
                    legs_live = None
                if legs_live is not False:
                    self._legs_gone_reset(str(oid))
                    bot_logger.warning(
                        f"Keeping {oid} tracked — SL/TP still working or unknown "
                        f"(legs_live={legs_live}); refusing ghost-flat release ({symbol})"
                    )
                    continue
                bot_logger.warning(
                    f"{oid} ({symbol}): SL/TP gone {_LEGS_GONE_CONFIRM_SEC:.0f}s+ and no exit "
                    f"fill found — releasing as manual/unknown close"
                )

            # Snapshot baskets + cancel every remaining leg (incl. native bracket
            # target/stop) BEFORE dropping tracking, or blank-tag Lucid rows are
            # unreachable afterwards and stay on the chart.
            self.remember_closed_entry(oid, symbol)
            try:
                self._run_sync(
                    self._async_cancel_remaining_bracket_legs(
                        oid, symbol, info, reason="position_closed_cleanup", force=True,
                    ),
                    timeout=20,
                )
            except Exception as e:
                error_logger.error(
                    f"Cancel remaining legs failed for {oid} (path=cleanup_closed_orders): {e}"
                )

            with self._order_lock:
                removed = self._orders.pop(oid, None)
            self._legs_gone_reset(str(oid))
            if not removed:
                continue

            bot_logger.info(
                f"🔄 Order {oid} ({symbol}) removed — "
                f"{'exit fill confirmed' if exit_confirmed else 'SL/TP gone, no fill (manual/unknown)'} "
                f"(path=cleanup_closed_orders)"
            )
            if removed.get("protective_sl_order_id") or removed.get("protective_tp_order_id"):
                try:
                    self._run_sync(
                        self._async_cancel_entry_protective_orders(
                            oid,
                            removed,
                            reason=("entry_exit_confirmed" if exit_confirmed
                                    else "entry_legs_gone_confirmed"),
                        ),
                        timeout=10,
                    )
                except Exception as e:
                    error_logger.error(
                        f"Failed to cancel orphan protective orders for {oid} "
                        f"(path=cleanup_closed_orders): {e}"
                    )

    def _refresh_account_pnl(self) -> None:
        """Sync account balance/equity from Rithmic PnL plant."""
        if not self._connected:
            return
        if not self._plant_ready("pnl"):
            self._log_missing_plant_once("pnl", "account_summary")
            return
        try:
            summaries = self._run_sync(
                self._client.list_account_summary(
                    account_id=self._get_account_id()
                ),
                timeout=10,
            )
            if summaries:
                data = _response_to_dict_safe(summaries[0])
                with self._state_lock:
                    if "account_balance" in data:
                        self._account_info["balance"] = float(data["account_balance"])
                    if "cash_on_hand" in data:
                        self._account_info["equity"] = float(data["cash_on_hand"])
                    elif "margin_balance" in data:
                        self._account_info["equity"] = float(data["margin_balance"])
        except Exception as e:
            if self._missing_plant_error(e):
                self._log_missing_plant_once("pnl", "account_summary")
                return
            error_logger.error(f"Rithmic account PnL refresh error: {e}")

