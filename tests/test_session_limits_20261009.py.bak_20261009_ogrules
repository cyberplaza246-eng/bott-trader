class _Clock(datetime):
    NOW = _t("2026-10-09T04:00:00")

    @classmethod
    def now(cls, tz=None):
        return cls.NOW if tz else cls.NOW.replace(tzinfo=None)


def test_trader_books_exit_and_blocks_new_entries_only(trader, monkeypatch):
    assert trader._session_ledger is not None
    monkeypatch.setattr(slr, "datetime", _Clock)
    for i, px in enumerate((31083.5, 31033.5)):
        oid = f"bot_on{i}"
        trader.positions[oid] = slr.Position(order_id=oid, symbol="MNQ", direction="short", entry_price=30976.25,
                                             size=1, sl=31083.25, tp=30762.25,
                                             entry_time=_t("2026-10-09T00:06:20"), exit_sleeve="breakout")
        trader.process_exit(oid, "STOP_LOSS", px)
    assert trader._session_ledger.pnl(date(2026, 10, 9), "overnight") < -300
    why = trader._session_limit_block()
    assert why and "overnight loss limit" in why
    # old calendar-day limit no longer stops the whole loop in session mode
    trader.daily_pnl = -900.0
    trader.current_date = _Clock.NOW.replace(tzinfo=None).date()
    assert trader.check_daily_limits() is True
    assert trader.check_entry_signal("MNQ", None) is None
    assert "STOPPED - overnight loss limit" in trader._session_status_line()
    gs = trader._revamp_gate_state("MNQ", 0)
    assert gs["daily_loss_limit"] == float("inf") and "overnight loss limit" in gs["session_block"]


def test_non_revamp_keeps_old_daily_limit(monkeypatch, tmp_path):
    monkeypatch.setattr(slr, "REVAMP_EXITS_ON", False)
    monkeypatch.setattr(slr, "bot_logger", MagicMock())
    t = slr.LiveRithmicTrader(symbol="MNQ", paper_mode=False, skip_confirm=True)
    assert t._session_ledger is None and t._session_limit_block() is None
    t.current_date = datetime.now().date()
    t.daily_pnl = -t.daily_loss_limit
    assert t.check_daily_limits() is False
