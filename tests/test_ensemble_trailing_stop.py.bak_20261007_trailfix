def test_past_tp_cancels_tp_enables_trail_and_floors_sl():
    t = _trader()
    t.paper_orders = True
    pos = _long_pos(sl=24960.0, tp=25100.0)
    t.positions[pos.order_id] = pos
    # High beyond TP; low stays above floored SL so we only assert no TAKE_PROFIT.
    df = pd.DataFrame([{"high": 25140.0, "low": 25105.0, "close": 25120.0, "atr": 20.0}])
    t.update_past_tp_to_trail("MNQ", df)
    assert pos.tp_cleared is True
    assert pos.tp == 0.0
    assert pos.original_tp == pytest.approx(25100.0)
    assert pos.trailing_enabled is True
    # SL floored at original TP
    assert pos.sl == pytest.approx(25100.0)
    # Local exit check must NOT emit TAKE_PROFIT once TP cleared
    exits = t.check_position_exit("MNQ", df)
    assert not any(et == "TAKE_PROFIT" for _, et in exits)
    assert exits == []


def test_past_tp_calls_broker_cancel_take_profit_live():
    t = _trader()
    t.paper_mode = False
    t.paper_orders = False
    pos = _long_pos(sl=24960.0, tp=25100.0)
    t.positions[pos.order_id] = pos
    t.broker.cancel_take_profit.return_value = True
    t.broker.update_stop_loss.return_value = True
    df = pd.DataFrame([{"high": 25125.0, "low": 25090.0, "close": 25120.0, "atr": 20.0}])
    t.update_past_tp_to_trail("MNQ", df)
    assert t.broker.cancel_take_profit.called
    kwargs = t.broker.cancel_take_profit.call_args.kwargs
    assert kwargs["ticket"] == pos.order_id
    assert kwargs["symbol"] == "MNQ"
    assert pos.tp_cleared is True
    assert pos.trailing_enabled is True


