def test_broker_can_update_stop_true_for_protective_stop_limit():
    info = {
        "supports_stop_modify": False,
        "native_stop_attached": True,
        "protective_sl_order_id": "bot_bf2e4111c8_sl",
        "bracket_mode": "protective_fallback",
    }
    assert slr.LiveRithmicTrader._broker_can_update_stop(info) is True
    assert slr.LiveRithmicTrader._broker_can_update_stop(
        {"can_update_stop": True, "supports_stop_modify": False}
    ) is True
    assert slr.LiveRithmicTrader._broker_can_update_stop(
        {"supports_stop_modify": False, "native_stop_attached": False}
    ) is False


def test_place_order_keeps_trailing_when_stop_limit_protective(monkeypatch):
    t = _trader()
    t.broker.place_order.return_value = {
        "ticket": "bot_bf2e4111c8",
        "entry_price": 25000.0,
        "supports_stop_modify": False,  # Lucid protective path
        "native_stop_attached": True,
        "protective_sl_order_id": "bot_bf2e4111c8_sl",
        "bracket_mode": "protective_fallback",
        "can_update_stop": True,
    }
    monkeypatch.setattr(t, "_write_board_status", lambda **kwargs: None)

    signal = {
        "symbol": "MNQ",
        "direction": "short",
        "entry": 25000.0,
        "sl": 25040.0,
        "tp": 24900.0,
        "trailing_enabled": True,
        "ensemble_signal": "SELL",
        "regime": "trend_down",
    }
    assert t.place_order(signal) is True
    pos = t.positions["bot_bf2e4111c8"]
    assert pos.trailing_enabled is True


def test_place_order_disables_trailing_only_when_no_broker_stop(monkeypatch):
    t = _trader()
    t.broker.place_order.return_value = {
        "ticket": "bot_nosl",
