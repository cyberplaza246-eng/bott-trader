def test_trail_after_past_tp_never_loosens_through_original_tp():
    t = _trader()
    t.paper_orders = True
    pos = _long_pos(sl=25100.0, tp=0.0)
    pos.tp_cleared = True
    pos.original_tp = 25100.0
    pos.trailing_enabled = True
    t.positions[pos.order_id] = pos
    # Wide ATR would want SL far below original TP — floor must hold.
    df = pd.DataFrame([{"high": 25140.0, "low": 25105.0, "close": 25130.0, "atr": 80.0}])
    t.update_trailing_stops("MNQ", df)
    assert pos.sl >= 25100.0 - 1e-9


def test_short_past_tp_floors_sl_at_original_tp():
    t = _trader()
    t.paper_orders = True
    pos = _short_pos(trailing=True)
    # short entry 25000, tp 24900, sl 25040
    t.positions[pos.order_id] = pos
    df = pd.DataFrame([{"high": 24920.0, "low": 24880.0, "close": 24890.0, "atr": 15.0}])
    t.update_past_tp_to_trail("MNQ", df)
    assert pos.tp_cleared is True
    assert pos.original_tp == pytest.approx(24900.0)
    assert pos.trailing_enabled is True
    assert pos.sl == pytest.approx(24900.0)
    assert pos.sl <= 24900.0
