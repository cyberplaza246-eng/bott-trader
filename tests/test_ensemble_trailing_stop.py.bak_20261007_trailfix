def _short_pos(*, trailing=True, order_id="bot_bf2e4111c8"):
    return slr.Position(
        order_id=order_id,
        symbol="MNQ",
        direction="short",
        entry_price=25000.0,
        size=1,
        sl=25040.0,
        tp=24900.0,
        entry_time=datetime.now(timezone.utc),
        trailing_enabled=trailing,
