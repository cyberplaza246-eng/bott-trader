        "supports_stop_modify": False,
        "native_stop_attached": False,
        "bracket_mode": "entry_only",
    }
    monkeypatch.setattr(t, "_write_board_status", lambda **kwargs: None)
    signal = {
        "symbol": "MNQ",
        "direction": "short",
        "entry": 25000.0,
        "sl": 25040.0,
        "tp": 24900.0,
        "trailing_enabled": True,
    }
    assert t.place_order(signal) is True
    assert t.positions["bot_nosl"].trailing_enabled is False


def test_apply_stop_update_does_not_disable_trail_after_protective_replace():
    t = _trader()
    pos = _short_pos()
    t.positions[pos.order_id] = pos
    t.broker.update_stop_loss.return_value = True
    t.broker.get_order_info.return_value = {
        "supports_stop_modify": False,
        "protective_sl_order_id": f"{pos.order_id}_sl",
        "native_stop_attached": True,
    }
    assert t._apply_stop_update(pos, 25020.0) is True
    assert pos.sl == 25020.0
    assert pos.trailing_enabled is True


def test_update_trailing_stops_uses_update_stop_loss_for_protective():
    t = _trader()
    pos = _short_pos()
    t.positions[pos.order_id] = pos
    t.broker.update_stop_loss.return_value = True
    t.broker.get_order_info.return_value = {
        "supports_stop_modify": False,
        "protective_sl_order_id": f"{pos.order_id}_sl",
    }

    # Favorable move for short: low well below entry; ATR trail should tighten SL down.
    df = pd.DataFrame(
        [
            {
                "high": 24990.0,
                "low": 24920.0,
                "close": 24940.0,
                "atr": 20.0,
            }
        ]
    )
    t.update_trailing_stops("MNQ", df)
    assert t.broker.update_stop_loss.called
    assert not t.broker.modify_position.called
    assert pos.trailing_enabled is True
    assert pos.sl < 25040.0


