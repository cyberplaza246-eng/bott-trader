def _bars(n=30, start=datetime(2026, 10, 8, 15, 0, tzinfo=UTC), base=31000.0, rng=10.0):
    ts = [start + timedelta(minutes=5 * i) for i in range(n)]
    close = np.full(n, base)
    return pd.DataFrame({"datetime": ts, "open": close, "high": close + rng, "low": close - rng,
                         "close": close, "volume": 100.0})


def test_compute_levels_swing_vs_atr_and_cap():
    df = _bars(6, base=31000.0, rng=10.0)            # 6-bar low 30990
    # swing: 31100 - (30990 - 0.25) = 110.25 > 1.5*20=30 -> swing wins
    assert rx.compute_levels("long", 31100.0, df, 20.0, 0.25, 2.0, 500) == (30989.75, 31320.5, 110.25)
    # ATR wins when wider: 1.5*100 = 150
    sl, tp, d = rx.compute_levels("long", 31000.0, df, 100.0, 0.25, 2.0, 500)
    assert d == 150.0 and sl == 30850.0 and tp == 31300.0
    # short: swing high 31010.25
    sl, tp, d = rx.compute_levels("short", 30900.0, df, 20.0, 0.25, 2.0, 500)
    assert (sl, tp, d) == (31010.25, 30679.5, 110.25)
    # cap: $500 on MNQ = 250 pts
    sl, tp, d = rx.compute_levels("long", 31600.0, df, 20.0, 0.25, 2.0, 500)
    assert d == 250.0 and sl == 31350.0 and tp == 32100.0
    # NQ $20/pt -> 25 pts
    assert rx.compute_levels("long", 31100.0, df, 20.0, 0.25, 20.0, 500)[2] == 25.0
    # cap off
    assert rx.compute_levels("long", 31600.0, df, 20.0, 0.25, 2.0, 0)[2] == 610.25
    assert rx.compute_levels("long", 31000.0, None, float("nan"), 0.25, 2.0, 500) is None


def test_completed_bars_drops_forming_bar():
    df = _bars(4)  # bars 15:00..15:15
    now = datetime(2026, 10, 8, 15, 17, tzinfo=UTC)  # 15:15 bar still forming
    assert len(rx.completed_bars(df, now)) == 3


def test_parent_peak_uses_bars_after_entry():
    df = _bars(6, base=31000.0, rng=10.0)
    df.loc[3, "high"] = 31150.0                       # 15:15 bar, after entry at 15:00
    p = _pos(peak_pts=100.0)                          # tracked peak 31100
    assert rx.parent_peak_price(p, df) == 31150.0
    assert rx.parent_peak_price(p, None) == 31100.0


