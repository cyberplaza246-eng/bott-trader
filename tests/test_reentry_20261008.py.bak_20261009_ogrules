def test_revamp_bat_enables_reentry_others_do_not():
    mnq = (ROOT / "start_mnq_live_revamp.bat").read_text(encoding="latin-1")
    for kv in ("REENTRY_ENABLED=1", "REENTRY_WINDOW_BARS=12", "REENTRY_MAX=1"):
        assert f'set "{kv}"' in mnq, kv
    for other in ROOT.glob("*.bat"):
        if other.name.lower() == "start_mnq_live_revamp.bat":
            continue
        assert 'REENTRY_ENABLED=1' not in other.read_text(encoding="latin-1", errors="replace"), other.name
