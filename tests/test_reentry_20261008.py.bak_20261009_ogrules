def _open_parent(t, **kw):
    p = _pos(**kw)
    t.positions[p.order_id] = p
    return p


def test_profitable_stop_exit_arms(trader, capsys):
    _open_parent(trader, peak_pts=100.0)              # peak 31100
    trader.process_exit("bot_parent", "STOP_LOSS", 31050.0)
    arm = trader._reentry_arms["bot_parent"]
    assert arm.trigger == 31100.25 and arm.direction == "long" and arm.confidence == 0.75
    out = capsys.readouterr().out
    assert "Re-entry armed: BUY above 31100.25 for 60 min" in out
    assert trader.reentry_status_lines("MNQ")[0].startswith("Re-entry armed: BUY above 31100.25 for ")


