def _pos(**kw):
    base = dict(order_id="bot_parent", symbol="MNQ", direction="long", entry_price=31000.0, size=1,
                sl=31050.0, tp=31400.0, entry_time=datetime(2026, 10, 8, 15, 0, tzinfo=UTC),
                exit_sleeve="breakout", peak_pts=100.0, confidence=0.75)
    base.update(kw)
    return slr.Position(**base)


def test_should_arm_only_profitable_stop_exits():
    p = _pos()
    assert rx.should_arm(p, "STOP_LOSS", 97.0, 31050.0, enabled=True, max_reentries=1)[0]
    assert not rx.should_arm(p, "TAKE_PROFIT", 797.0, 31400.0, enabled=True, max_reentries=1)[0]
    assert not rx.should_arm(p, "STOP_LOSS", -103.0, 30950.0, enabled=True, max_reentries=1)[0]
    assert not rx.should_arm(p, "BROKER_SYNC_UNKNOWN", 0.0, 0.0, enabled=True, max_reentries=1)[0]
    assert not rx.should_arm(p, "STOP_LOSS", 97.0, 31050.0, enabled=False, max_reentries=1)[0]


def test_should_arm_skips_adopted_and_reentries_past_max():
    assert not rx.should_arm(_pos(order_id="bot_adopt_db0dcf1fa6"), "STOP_LOSS", 50, 31050, True, 1)[0]
    assert not rx.should_arm(_pos(regime="broker_adopt"), "STOP_LOSS", 50, 31050, True, 1)[0]
    assert not rx.should_arm(_pos(reentry_gen=1), "STOP_LOSS", 50, 31050, True, 1)[0]
    assert rx.should_arm(_pos(reentry_gen=1), "STOP_LOSS", 50, 31050, True, 2)[0]


def test_arm_trigger_expiry_and_status_text():
    now = datetime(2026, 10, 8, 17, 0, tzinfo=UTC)
    a = rx.make_arm(_pos(), 31100.0, 0.25, now, 0.75, window_bars=12)
    assert a.trigger == 31100.25 and a.side == "BUY" and a.gen == 1
    assert a.expires_at == now + timedelta(minutes=60)
    assert a.status_text(now + timedelta(minutes=5)) == "Re-entry armed: BUY above 31100.25 for 55 min"
    s = rx.make_arm(_pos(direction="short", entry_price=31000.0), 30900.0, 0.25, now, 0.7, window_bars=12)
    assert s.trigger == 30899.75
    assert s.status_text(now) == "Re-entry armed: SELL below 30899.75 for 60 min"
    assert rx.triggered(a, 31100.25) and not rx.triggered(a, 31100.0)
    assert rx.triggered(s, 30899.5) and not rx.triggered(s, 30900.0) and not rx.triggered(s, 0)


