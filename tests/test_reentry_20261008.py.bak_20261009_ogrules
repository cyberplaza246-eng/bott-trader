def _arm(trader, monkeypatch, **kw):
    _open_parent(trader, **kw)
    trader.process_exit("bot_parent", "STOP_LOSS", 31050.0 if kw.get("direction", "long") == "long" else 30950.0)
    trader.cooldown = 1                                 # post-exit cooldown is active
    now = datetime.now(UTC)
    trader.get_candles = lambda symbol=None, count=100: _bars(30, start=now - timedelta(minutes=5 * 31),
                                                               base=31060.0, rng=8.0)


def test_no_fire_below_trigger(trader, monkeypatch):
    _arm(trader, monkeypatch)
    trader.broker.get_latest_price.return_value = {"last": 31100.0}
    assert trader.check_reentry_triggers() == 0
    trader.broker.place_order.assert_not_called()
    assert "bot_parent" in trader._reentry_arms


def test_fires_market_reentry_on_break_bypassing_cooldown(trader, monkeypatch):
    _arm(trader, monkeypatch)
    trader.broker.get_latest_price.return_value = {"last": 31100.25}
    assert trader.check_reentry_triggers() == 1
    kw = trader.broker.place_order.call_args.kwargs
    # swing low of last 6 completed bars = 31052 -> dist 31100.25 - 31051.75 = 48.5 (> 1.5 ATR=24)
    assert kw["order_type"] == "buy" and kw["size"] == 1
    assert kw["stop_loss"] == 31051.75 and kw["take_profit"] == 31197.25
    pos = trader.positions["bot_re1"]
    assert pos.reentry_gen == 1 and pos.reentry_parent == "bot_parent" and pos.confidence == 0.75
    assert pos.exit_sleeve == "breakout"
    assert not trader._reentry_arms                    # consumed
    # its own profitable stop exit does not arm a 2nd re-entry (REENTRY_MAX=1)
    trader.positions["bot_re1"].peak_pts = 60.0
    trader.process_exit("bot_re1", "STOP_LOSS", 31130.0)
    assert not trader._reentry_arms


def test_short_reentry(trader, monkeypatch):
    _arm(trader, monkeypatch, direction="short", entry_price=31100.0, sl=31050.0, tp=30700.0, peak_pts=100.0)
    arm = trader._reentry_arms["bot_parent"]
    assert arm.trigger == 30999.75
    trader.broker.get_latest_price.return_value = {"last": 30999.5}
    assert trader.check_reentry_triggers() == 1
    kw = trader.broker.place_order.call_args.kwargs
    assert kw["order_type"] == "sell" and kw["stop_loss"] > 30999.5 and kw["take_profit"] < 30999.5


@pytest.mark.parametrize("setup,needle", [
    ("daily", "daily loss cap"),
    ("maxconc", "max concurrent"),
    ("conf", "extra trade needs conf"),
    ("pause", "consecutive-loss pause"),
])
def test_gates_block_and_consume(trader, monkeypatch, capsys, setup, needle):
    _arm(trader, monkeypatch, confidence=0.66)
    if setup == "daily":
        trader.daily_pnl = -trader.daily_loss_limit
    elif setup == "maxconc":
        for i in range(trader.max_positions):
            trader.positions[f"o{i}"] = _pos(order_id=f"o{i}", confidence=0.9)
    elif setup == "conf":
        trader.positions["o1"] = _pos(order_id="o1", confidence=0.9)   # 1 open, parent conf 0.66 < 0.72
    elif setup == "pause":
        trader._consec_loss_pause_until["MNQ"] = datetime.now(UTC) + timedelta(minutes=30)
    trader.broker.get_latest_price.return_value = {"last": 31101.0}
    assert trader.check_reentry_triggers() == 0
    trader.broker.place_order.assert_not_called()
    assert not trader._reentry_arms
    assert needle in capsys.readouterr().out


