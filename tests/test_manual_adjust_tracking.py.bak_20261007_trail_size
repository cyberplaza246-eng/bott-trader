class AdjustBroker:
    connected = True

    def __init__(self):
        self._orders: Dict[str, Dict[str, Any]] = {}
        self._positions: Dict[str, Dict[str, Any]] = {}
        self._order_lock = threading.RLock()
        self._state_lock = threading.RLock()
        self._confirmed_exit_fills: Dict[str, Dict[str, Any]] = {}
        self.brackets: Dict[str, Dict[str, Any]] = {}
        self.released: List[tuple] = []
        self.sweeps: List[tuple] = []

    def get_open_positions(self, symbol=None):
        return []

    def entry_protection_grace_active(self, order_id):
        return False

    def get_order_info(self, ticket):
        return self._orders.get(str(ticket))

    def sync_tracked_brackets(self, symbol):
        return {k: dict(v) for k, v in self.brackets.items()}

    def release_closed_entry(self, order_id, symbol, reason=""):
        self.released.append((order_id, symbol, reason))
        self._orders.pop(order_id, None)
        return 1

    def sweep_orphan_working_orders(self, symbol, live_entry_ids=None, reason=""):
        self.sweeps.append((symbol, set(live_entry_ids or ()), reason))
        return {"cancelled": 0}

    def confirm_bracket_exit_fill(self, *a, **k):
        return None


def _pos(oid, age=120.0):
    return slr.Position(order_id=oid, symbol="MNQ", direction="long", entry_price=100.0, size=1,
                        sl=95.0, tp=110.0,
                        entry_time=datetime.now(timezone.utc) - timedelta(seconds=age))


def _trader():
    t = slr.LiveRithmicTrader(symbol="MNQ", symbols=["MNQ"], paper_mode=False, skip_confirm=True)
    t.broker = AdjustBroker()
    t.paper_orders = False
    t._feed_learner_on_exit = MagicMock()
    t._write_board_status = MagicMock()
    return t


def test_adjust_tp_on_one_of_two_then_close_frees_slot():
    t = _trader()
    for oid in ("bot_a", "bot_b"):
        t.positions[oid] = _pos(oid)
        t.broker._orders[oid] = {"symbol": "MNQ", "size": 1}
    # 1) user moves bot_a TP 110 → 114 on Lucid
    t.broker.brackets = {
        "bot_a": {"sl": 95.0, "tp": 114.0, "sl_working": True, "tp_working": True, "rebound": []},
        "bot_b": {"sl": 95.0, "tp": 110.0, "sl_working": True, "tp_working": True, "rebound": []},
    }
    t.sync_broker_position()
    assert set(t.positions) == {"bot_a", "bot_b"}, "adjusted trade must stay tracked"
    assert t.positions["bot_a"].tp == 114.0 and t.positions["bot_b"].tp == 110.0
    assert t._effective_open_count() == 2
    # 2) adjusted TP fills on the broker
    t.broker._confirmed_exit_fills["bot_a"] = {"confirmed": True, "leg": "TP", "exit_price": 114.0}
    t.broker.brackets.pop("bot_a")
    t.sync_broker_position()
    assert "bot_a" not in t.positions and "bot_b" in t.positions
    assert t.trades[-1]["exit_type"] == "TAKE_PROFIT" and t.trades[-1]["exit_price"] == 114.0
    assert ("bot_a", "MNQ", "exit_take_profit") in t.broker.released
    assert t.broker.sweeps[-1][1] == {"bot_b"}, "other trade keeps its SL/TP"
    assert len(t.positions) < t.max_positions, "slot must be free to place again"


def test_confirmed_fill_closes_even_inside_ghost_grace():
    t = _trader()
    t.positions["bot_a"] = _pos("bot_a", age=5)
    t.broker._orders["bot_a"] = {"symbol": "MNQ", "size": 1}
    t.broker._confirmed_exit_fills["bot_a"] = {"confirmed": True, "leg": "SL", "exit_price": 95.0}
    t.sync_broker_position()
    assert "bot_a" not in t.positions
    assert t.trades[-1]["exit_type"] == "STOP_LOSS"


def test_manual_close_of_one_trade_frees_slot_while_other_keeps_symbol_open():
    t = _trader()
    t.positions["bot_a"] = _pos("bot_a")
    t.positions["bot_b"] = _pos("bot_b")
    t.broker._orders["bot_b"] = {"symbol": "MNQ", "size": 1}   # connector dropped bot_a
    t.broker._positions["MNQ"] = {"size": 1}                   # broker net 1 = bot_b
    t.sync_broker_position()
    assert "bot_a" not in t.positions and "bot_b" in t.positions
    assert ("bot_a", "MNQ", "broker_sync_flat") in t.broker.released


def test_untracked_extra_size_is_not_released():
    t = _trader()
    t.positions["bot_a"] = _pos("bot_a")
    t.positions["bot_b"] = _pos("bot_b")
    t.broker._orders["bot_b"] = {"symbol": "MNQ", "size": 1}
    t.broker._positions["MNQ"] = {"size": 2}   # both still open on broker
    t.sync_broker_position()
    assert set(t.positions) == {"bot_a", "bot_b"}


def test_unworking_leg_prices_are_not_overwritten():
    t = _trader()
    t.positions["bot_a"] = _pos("bot_a")
    t.broker._orders["bot_a"] = {"symbol": "MNQ", "size": 1}
    t.broker.brackets = {"bot_a": {"sl": 0.0, "tp": 0.0, "sl_working": False, "tp_working": False}}
    t.sync_broker_position()
    assert t.positions["bot_a"].sl == 95.0 and t.positions["bot_a"].tp == 110.0


