def _cleanup_conn(rows, net):
    conn = _conn(rows, net=net)
    conn._async_list_positions = AsyncMock(return_value=[{"symbol": "MNQ"}])
    conn._list_positions_net_qty = MagicMock(return_value=net)
    conn._async_cancel_remaining_bracket_legs = AsyncMock(return_value=0)
    conn._async_cancel_entry_protective_orders = AsyncMock(return_value=None)
    return conn


def test_cleanup_waits_for_replaced_legs_before_dropping(monkeypatch):
    monkeypatch.setattr(rc, "_LEGS_GONE_CONFIRM_SEC", 12.0)
    monkeypatch.setattr(rc, "_LEGS_GONE_CONFIRM_PASSES", 2)
    conn = _cleanup_conn([], net=0)
    _two_longs(conn)
    conn._orders = {k: v for k, v in conn._orders.items() if k.startswith("bot_a")}
    conn._async_is_entry_still_open = AsyncMock(return_value=False)  # legs mid cancel/replace
    conn._cleanup_closed_orders()
    assert "bot_a" in conn._orders, "must not drop the trade the instant its legs vanish"
    conn._legs_gone_since()["bot_a"] -= 13
    conn._cleanup_closed_orders()
    assert "bot_a" not in conn._orders


