def test_fill_of_adjusted_blank_tag_tp_is_detected_and_sibling_cancelled():
    from async_rithmic.enums import ExchangeOrderNotificationType
    conn = _conn([], net=1)
    _two_longs(conn)
    conn._orders["bot_a"]["protective_tp_basket_id"] = "900"
    conn._orders["bot_a_tp"]["basket_id"] = "900"
    conn._async_get_order_snapshot = AsyncMock(return_value=None)   # tag lookup misses
    conn._client.list_orders = AsyncMock(return_value=[
        _row("", "900", "LIMIT", price=115.0, status="complete"),
    ])
    conn._async_cancel_remaining_bracket_legs = AsyncMock(return_value=1)
    asyncio.run(conn._on_exchange_order_notification({
        "user_tag": "", "basket_id": "900", "fill_price": 115.0,
        "notify_type": ExchangeOrderNotificationType.FILL,
    }))
    fill = conn._confirmed_exit_fills["bot_a"]
    assert fill["confirmed"] and fill["leg"] == "TP" and fill["exit_price"] == 115.0
    targets = [c.args[0] for c in conn._async_cancel_protective_leg.await_args_list]
    assert "bot_a_sl" in targets and "bot_b_sl" not in targets


