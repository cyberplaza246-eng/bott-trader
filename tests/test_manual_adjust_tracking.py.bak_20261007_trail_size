def test_never_adopts_manual_tagged_wrong_side_oversize_or_closed_entry_rows():
    rows = [
        _row("manual_x", "31", "LIMIT", price=112.0),          # tagged manual
        _row("", "32", "LIMIT", side="BUY", price=90.0),        # opening side
        _row("", "33", "LIMIT", price=112.0, qty=3),            # bigger than entry
        _row("", "34", "LIMIT", price=112.0),                   # leftover of closed entry
    ]
    conn = _conn(rows)
    _two_longs(conn)
    conn._closed_entry_registry()["bot_old"] = {
        "baskets": {"34"}, "legs": set(), "symbol": "MNQ", "closed_at": time.time(), "clean_passes": 0,
    }
    out = asyncio.run(conn._async_rebind_symbol_legs("MNQ"))
