# ── connector: rebind ──────────────────────────────────────────────

def test_same_basket_modify_with_blank_tag_follows_new_price():
    rows = [
        _row("bot_a_sl", "11", "STOP_LIMIT", trigger=95.0, price=94.75),
        _row("", "12", "LIMIT", price=114.0),          # user dragged TP 110 → 114
        _row("bot_b_sl", "21", "STOP_LIMIT", trigger=96.0),
        _row("bot_b_tp", "22", "LIMIT", price=111.0),
    ]
    conn = _conn(rows)
    _two_longs(conn)
    out = asyncio.run(conn._async_rebind_symbol_legs("MNQ"))
    assert out["bot_a"]["tp_working"] and out["bot_a"]["tp"] == 114.0
    assert out["bot_a"]["sl"] == 95.0
    assert conn._orders["bot_a"]["take_profit"] == 114.0
    assert conn._orders["bot_b"]["take_profit"] == 111.0
    assert out["bot_a"]["rebound"] == []


def test_cancel_replace_tp_is_adopted_without_stealing_other_trade_legs():
    rows = [
        _row("bot_a_sl", "11", "STOP_LIMIT", trigger=95.0),
        # bot_a TP (12) cancelled by user; new blank-tag sell limit 900 placed
        _row("", "900", "LIMIT", price=115.0),
        _row("bot_b_sl", "21", "STOP_LIMIT", trigger=96.0),
        _row("bot_b_tp", "22", "LIMIT", price=111.0),
    ]
    conn = _conn(rows)
    _two_longs(conn)
    out = asyncio.run(conn._async_rebind_symbol_legs("MNQ"))
    assert out["bot_a"]["rebound"] == ["tp"] and out["bot_a"]["tp"] == 115.0
    assert conn._orders["bot_a"]["protective_tp_basket_id"] == "900"
    assert conn._orders["bot_a_tp"]["basket_id"] == "900"
    assert conn._orders["bot_b"]["protective_tp_basket_id"] == "22"
    assert "900" in conn._known_bot_baskets_for_entry("bot_a")  # cleanup will reach it
    assert conn._leg_tag_for_basket("900") == "bot_a_tp"       # fills resolve to bot_a


